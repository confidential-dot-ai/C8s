== etc/nri/conf.d/image-policy.yaml -rw------- ==
allowlist:
    base:
        schema: c8s.allowlist/v1
        workloads:
            kube-apiserver:
                containers:
                    - digest: sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
                      command:
                        policy: any
                      args:
                        policy: exact
                        argv:
                            - --advertise-address=192.0.2.21
                            - --node-name=n1
                            - --secure-port=6443
                      mounts:
                        policy: deny
                      env:
                        policy: any
            operator:
                containers:
                    - digest: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
                      command:
                        policy: any
                      args:
                        policy: any
                      mounts:
                        policy: deny
                      env:
                        policy: any
    pull:
        cds_measurements_config: /run/c8s-node/cds.json
        cds_pin_floor: 9
        timeout: 30s
        url: https://cds.example.org:8443
mesh:
    capture:
        health: 15021
        inbound: 15006
        outbound: 15001
    cluster_ranges:
        - 10.52.0.0/16
        - 10.53.0.0/16
    exempt_namespaces:
        - kube-system
    resolver: 10.53.0.10
    roles:
        - name: mesh
          uid: 1337
        - name: credentials
          port: 8443
          uid: 1338
platform: tdx
policy:
    enforce_existing: true
    mode: fail-closed
