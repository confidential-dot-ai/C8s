            mounts: {policy: any}
      hardened-etcd-4f7ffbb3399c:
        label: "docker.io/rancher/hardened-etcd:v3.6.14-k3s1-build20260819"
        containers:
          - digest: "sha256:4f7ffbb3399c9f8137f5d0dd3ca0eddc7909e5d0155b35f1b0449baf96d61bfa"
            image: "docker.io/rancher/hardened-etcd:v3.6.14-k3s1-build20260819"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      hardened-flannel-89d695035932:
        label: "docker.io/rancher/hardened-flannel:v0.28.9-build20260819"
        containers:
          - digest: "sha256:89d695035932b7b2dc482e8837f83237d80ada7d019a877cdcb379403e32f590"
            image: "docker.io/rancher/hardened-flannel:v0.28.9-build20260819"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      hardened-k8s-metrics-server-4935e86e846d:
        label: "docker.io/rancher/hardened-k8s-metrics-server:v0.9.0-build20260819"
        containers:
          - digest: "sha256:4935e86e846d75591113f64ad4e0402718a1eda08f6900a9325d54f1df64945c"
            image: "docker.io/rancher/hardened-k8s-metrics-server:v0.9.0-build20260819"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      hardened-kubernetes-c8e5263407ac:
        label: "docker.io/rancher/hardened-kubernetes:v1.36.4-rke2r1-build20260821"
        containers:
          - digest: "sha256:c8e5263407ac439de1dcdde98c7623efb9e17050715a80259d8bd5e81b5a9289"
            image: "docker.io/rancher/hardened-kubernetes:v1.36.4-rke2r1-build20260821"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      hardened-snapshot-controller-8d5872d767f9:
        label: "docker.io/rancher/hardened-snapshot-controller:v8.6.0-build20260819"
        containers:
          - digest: "sha256:8d5872d767f93393273cb1ecad81e4bc08af65311d206bc31ee8f48bc58e51c4"
            image: "docker.io/rancher/hardened-snapshot-controller:v8.6.0-build20260819"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      hardened-traefik-dff360a22c8a:
        label: "docker.io/rancher/hardened-traefik:v3.7.11-build20260819"
        containers:
          - digest: "sha256:dff360a22c8a28c2af3e78b2b4cf09a6c8edc199e27eb9f7c417bfc1ac41078e"
            image: "docker.io/rancher/hardened-traefik:v3.7.11-build20260819"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      klipper-helm-ba922718d919:
        label: "docker.io/rancher/klipper-helm:v0.13.3-build20260820"
        containers:
          - digest: "sha256:ba922718d919920b6b6168e3f55f8effa85032a38bf44d8cc5f4df79a2fe405d"
            image: "docker.io/rancher/klipper-helm:v0.13.3-build20260820"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      klipper-lb-910944bb0bd9:
        label: "docker.io/rancher/klipper-lb:v0.4.17"
