      rke2-cloud-provider-95a33533d97b:
        label: "docker.io/rancher/rke2-cloud-provider:v1.36.4-0.20260817193921-a2fc9574e060-build20260820"
        containers:
          - digest: "sha256:95a33533d97b10502be19e4f3e60e7ce9c30f4879084709af96259a01253f044"
            image: "docker.io/rancher/rke2-cloud-provider:v1.36.4-0.20260817193921-a2fc9574e060-build20260820"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      rke2-runtime-7956a28b1ebd:
        label: "docker.io/rancher/rke2-runtime:v1.36.4-rke2r1"
        containers:
          - digest: "sha256:7956a28b1ebd803f58341ba88fed4c8bc878ec13226c2e55959ba5a88c21341e"
            image: "docker.io/rancher/rke2-runtime:v1.36.4-rke2r1"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      k8s-device-plugin-25cc340fe6fd:
        label: "nvcr.io/nvidia/k8s-device-plugin:v0.19.3@sha256:25cc340fe6fd53c101e16fc452f503e7a92c219c64a80ed5381784b522dbbf77"
        containers:
          - digest: "sha256:25cc340fe6fd53c101e16fc452f503e7a92c219c64a80ed5381784b522dbbf77"
            image: "nvcr.io/nvidia/k8s-device-plugin:v0.19.3@sha256:25cc340fe6fd53c101e16fc452f503e7a92c219c64a80ed5381784b522dbbf77"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      local-path-provisioner-1eba82e9c386:
        label: "rancher/local-path-provisioner:v0.0.36@sha256:1eba82e9c386038b4af6d69cca7519fac738c28c42735ed48ce70c882ad0d80f"
        containers:
          - digest: "sha256:1eba82e9c386038b4af6d69cca7519fac738c28c42735ed48ce70c882ad0d80f"
            image: "rancher/local-path-provisioner:v0.0.36@sha256:1eba82e9c386038b4af6d69cca7519fac738c28c42735ed48ce70c882ad0d80f"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      # END rke2 system images
      # The platform roles the enforcer grants inside a member pod. A role
      # comes from this measured base alone: the JSON ingest drops the field,
      # so a document CDS serves can never claim one (pkg/allowlist).
      #
      # INVARIANT: every command, and every exact args and mounts policy, is
      # what the injector builds for that container over the image's
      # entrypoint (internal/webhook, TestMeasuredBaseAdmitsTheInjectedArgv).
      # An args or mounts policy is any only where the pod chooses them.
      c8s-mesh-endpoint:
        label: "armtls-mesh"
        containers:
          - digest: "@MESH_DIGEST@"
            image: "@MESH_REPO@@@MESH_DIGEST@"
            role: "mesh"
            command: {policy: exact, argv: ["/app/c8s", "armtls-mesh"]}
            args:
              policy: exact
              argv:
                - "--cert-path=/etc/c8s/certs/tls.crt"
                - "--key-path=/etc/c8s/certs/tls.key"
                - "--ca-path=/etc/c8s/certs/ca.crt"
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
      c8s-get-cert:
        label: "c8s get-cert"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "get-cert"]}
            # Per pod: the SAN it requests and the discovery files it writes.
            args: {policy: any}
            mounts: {policy: any}
      c8s-probe-file:
        label: "c8s probe-file"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "probe-file"]}
            args: {policy: exact, argv: ["--wait", "--timeout=3m0s", "/etc/c8s/certs/tls.crt"]}
            # Per pod: the discovery volume get-cert writes.
            mounts: {policy: any}
      c8s-get-secret:
        label: "c8s get-secret"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "get-secret"]}
            # Per pod: the secrets it fetches and where they land.
            args: {policy: any}
            mounts: {policy: any}
      c8s-get-volume:
        label: "c8s get-volume"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "get-volume"]}
            # Per pod: the volumes it opens and where they are mounted.
            args: {policy: any}
            mounts: {policy: any}
      # The router's own containers. The chart renders its pod itself, and
      # every pod of the router namespace holds platform-role containers
      # only, so each of them takes a role from here. The router
      # role serves the front door's ports; the acme role is the one that
      # reaches outside the cluster in the clear; the credentials role
      # reaches the node's CDS.
      c8s-router-nginx:
        label: "c8s router"
        containers:
          - digest: "@ROUTER_DIGEST@"
            image: "@ROUTER_REPO@@@ROUTER_DIGEST@"
            role: "router"
            command: {policy: exact, argv: ["/c8s", "router"]}
            # Per cluster: where it proxies and what it exposes.
            args: {policy: any}
            # The credentials it serves and the scratch it renders its own
            # configuration on. A front door mounting anything else is refused,
            # so the configuration cannot arrive from outside the image.
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                - destination: "/discovery"
                  kind: "emptyDir"
                - destination: "/var/cache/nginx"
                  kind: "emptyDir"
                - destination: "/tmp"
                  kind: "emptyDir"
          # The webpki front door serves an operator-supplied Secret, which
          # the kubelet presents as data, so its destination sits below the
          # reserved data prefix.
          - digest: "@ROUTER_DIGEST@"
            image: "@ROUTER_REPO@@@ROUTER_DIGEST@"
            role: "router"
            command: {policy: exact, argv: ["/c8s", "router"]}
            args: {policy: any}
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                - destination: "/mnt/c8s-data/public-tls"
                  kind: "data"
                - destination: "/discovery"
                  kind: "emptyDir"
                - destination: "/var/cache/nginx"
                  kind: "emptyDir"
                - destination: "/tmp"
                  kind: "emptyDir"
          # The acme front door reads the leaf its sidecar mints as well.
          - digest: "@ROUTER_DIGEST@"
            image: "@ROUTER_REPO@@@ROUTER_DIGEST@"
            role: "router"
            command: {policy: exact, argv: ["/c8s", "router"]}
            args: {policy: any}
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                - destination: "/etc/c8s-acme-tls"
                  kind: "emptyDir"
                - destination: "/discovery"
                  kind: "emptyDir"
                - destination: "/var/cache/nginx"
                  kind: "emptyDir"
                - destination: "/tmp"
                  kind: "emptyDir"
      c8s-acme:
        label: "c8s acme"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "acme"
            command: {policy: exact, argv: ["/c8s", "acme"]}
            # Per cluster: the domains it proves, the ACME directory it uses
            # and the account it registers.
            args: {policy: any}
            # Its own leaf's volume and nothing else: the ACME key is the one
            # credential this role mints for itself.
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s-acme-tls"
                  kind: "emptyDir"
      c8s-cds-attest:
        label: "c8s cds-attest"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "router"
            command: {policy: exact, argv: ["/c8s", "cds-attest"]}
            # Per cluster: the upstream it fronts and the leaf it binds.
            args: {policy: any}
            mounts: {policy: any}
      c8s-allowlist-proxy:
        label: "c8s allowlist-proxy"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "allowlist-proxy"]}
            # Per cluster: the port it listens on.
            args: {policy: any}
            mounts: {policy: any}
  pull:
    # Authenticated launch staging replaces this endpoint with the server's
    # CDS URL. The pull loop retries while the baked CDS service starts;
    # the plugin stays Ready on the base allowlist above.
    url: "https://127.0.0.1:30808"
    # INVARIANT: equal to the chart's nriImagePolicy.refresh.interval.
    interval: "5s"
    timeout: "30s"
    attestation_api_url: "http://127.0.0.1:8400"
    cds_measurements_config: "/run/confos/launch/cds.json"

# The measured mesh policy: what a member pod's packet ruleset is built from,
# and the identity each platform role runs as. A node whose config carries no
# mesh policy hosts no member pods (internal/cmds/nri-image-policy/roles.go).
mesh:
  # These namespaces keep the node's own rules: kube-system and the C8s system
  # namespace run the node's trusted components, which need host privileges a
  # member pod may not hold (volumed needs SYS_ADMIN).
  exempt_namespaces:
    - kube-system
    - c8s-system
  # INVARIANT: equal to cluster-dns in etc/rancher/rke2/config.yaml. A
  # config.yaml.d drop-in that moves the cluster DNS breaks name resolution in
  # member pods closed, never open.
  resolver: "10.53.0.10"
  # This cluster's pod and Service ranges. The acme role of the router's
  # namespace is the one identity whose sockets leave the cluster in the clear,
  # and its exception excludes these ranges, so a dial to a member is captured
  # and rides the mesh like any other application connection.
  #
  # INVARIANT: equal to cluster-cidr and service-cidr in
  # etc/rancher/rke2/config.yaml.
  cluster_ranges: ["10.52.0.0/16", "10.53.0.0/16"]
  # INVARIANT: equal to the ports the injected endpoint binds
  # (pkg/workloadclaims.Mesh*Port).
  capture:
    outbound: 15001
    inbound: 15006
    health: 15021
  # The mesh endpoint holds no capabilities: the enforcer installs the pod
  # ruleset, so the endpoint only proxies. Boot preparation adds the
  # credential role, whose destination is the staged CDS address
  # (internal/cmds/nodeservices).
  roles:
    - name: mesh
      uid: 1337

containerd:
  socket: "/run/k3s/containerd/containerd.sock"
  namespace: "k8s.io"

policy:
  mode: "fail-closed"
  enforce_existing: true
  deny_missing_annotation: true
  # A container already running when the plugin first registers means one ran
  # before admission existed — the plugin is pre-registered in containerd's
  # config and required_plugins blocks creation while it is absent, so in a
  # valid boot the set is empty. It has already executed by then, so the node
  # powers off rather than stopping it.
  #
  # A plugin restart is not that event: containerd stays up and its containers
  # legitimately predate the new process. The marker below is on tmpfs, so it
  # separates the two, and a restart re-checks what is running against the
  # allowlist instead.
  fatal_existing: true
  boot_marker_path: "/run/nri-image-policy/registered"
  #
  # Host privilege outside the node TCB: host namespaces, host bind mounts,
  # devices, CDI injection, OCI hooks and the marks of a privileged container
  # (see docs/allowlist-and-capabilities.md, "Host privilege").
  #
  # AUDIT, not enforce, and this is the one thing to flip: C8s's own node-level
  # components (volumed, armtls-mesh, the attestation-api proxy, router, the
  # nri-image-policy installer) legitimately use hostPath and hostNetwork, and
  # they reach this plugin through the CDS-served document rather than through
  # the base above, so enforcing today would deny them. Resolve their digests
  # into the measured base the way boot preparation already merges the
  # chart-derived component seed, then set this to "enforce".
  sandbox: "audit"
  label_rules: []

logging:
  level: "info"
