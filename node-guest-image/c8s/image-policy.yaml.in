          - digest: "sha256:910944bb0bd94f060a82a56ca1ea1c577d3e49b3473a093a47a985f32e92d94a"
            image: "docker.io/rancher/klipper-lb:v0.4.17"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      mirrored-pause-f548e0e8e3dc:
        label: "docker.io/rancher/mirrored-pause:3.10.2"
        containers:
          - digest: "sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
            image: "docker.io/rancher/mirrored-pause:3.10.2"
            command: {policy: any}
            args: {policy: any}
