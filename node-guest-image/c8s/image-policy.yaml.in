# Measured NRI bootstrap base allowlist. mkosi.sync pins the operator image and RKE2
# system images at build time. Authenticated launch staging selects the CDS
# endpoint and complete server image/key policy before containerd starts.
# The immutable source remains /usr/lib/c8s/image-policy.yaml; the staged copy
# under /etc/nri is writable only through the node's ephemeral state overlay.
platform: "@PLATFORM@"

plugin:
  health_addr: "unix:///run/nri-image-policy/health.sock"

# The node-CVM admission inventory (c8s docs/armtls.md, "Sandbox identity").
# get-cert dials this socket for its pod's digests before CDS will issue a
# certificate. Authenticated launch staging preserves this baked inventory
# configuration; without it the socket is never created and every adopted workload
# hangs waiting for a certificate that cannot be issued.
workload_claims:
  socket_dir: "/run/nri-image-policy"
  # The plugin is launched by containerd on the host, so its /proc is the
  # host's — a caller PID from SO_PEERCRED resolves directly.
  proc_root: "/proc"
  # Empty falls back to NodeIPFile (node-ip in socket_dir). After authenticated
  # launch staging, nri-node-ip.service publishes the node address before
  # either RKE2 role starts. Without that file, this resolves to 127.0.0.1
  # and the plugin refuses
  # to start with "inventory host is not a routable unicast address".
  advertise_host: ""

allowlist:
  # This base is the node's trusted computing base: it is measured with the
  # image, so its digests are the only ones the sandbox policy below exempts.
  # Everything CDS serves is sandboxed. Never set this in a config rendered by
  # the chart — that base is the cluster admin's to choose.
  node_tcb: true

  # Measured RKE2 system floor. Boot preparation merges the chart-derived
  # core component seed here before containerd starts, breaking the CDS
  # bootstrap dependency. Tenant launch workloads remain in CDS's served
  # policy; they cannot replace measured bootstrap entries.
  base:
    schema: c8s.allowlist/v1
    workloads:
      # BEGIN rke2 system images
      # One entry per system pod the node runs, each container at the digest
      # containerd stores for its image: systemfloor checks these against the
      # pinned bundles and baked manifests (an RKE2 pin bump: see mkosi.sync).
      # The bundles' other images never run as a container here: rke2-runtime
      # (rke2 unpacks it), mirrored-pause (the pod sandbox, which admission
      # never sees), hardened-traefik, klipper-lb, hardened-dns-node-cache and
      # hardened-addon-resizer (add-ons disabled in etc/rancher/rke2/config.yaml
      # or off in RKE2's charts), and Cilium's certgen, envoy,
      # clustermesh-apiserver, hubble and cloud-specific operator images (off
      # in rke2-cilium-config.yaml and the chart's defaults). Turning one on
      # needs an entry here.
      #
      # The static pods' argv and mounts are what RKE2 derives from
      # etc/rancher/rke2/config.yaml, as captured from booted nodes
      # (internal/cmds/nodeservices/testdata/rke2-system-pods). Boot
      # preparation fills ${NODE_NAME} and ${NODE_ADVERTISE_ADDRESS} with this
      # node's launch values. What each entry leaves open, and why:
      # docs/allowlist-and-capabilities.md, "Host privilege".

      # RKE2 static pod (servers).
      kube-apiserver:
        containers:
          - digest: "sha256:c8e5263407ac439de1dcdde98c7623efb9e17050715a80259d8bd5e81b5a9289"
            image: "docker.io/rancher/hardened-kubernetes:v1.36.4-rke2r1-build20260821"
            command: {policy: exact, argv: ["kube-apiserver"]}
            args:
              policy: exact
              argv:
                - "--admission-control-config-file=/etc/rancher/rke2/psa-config.yaml"
                - "--audit-policy-file=/etc/rancher/rke2/audit-policy.yaml"
                - "--audit-log-maxage=30"
                - "--audit-log-maxbackup=10"
                - "--audit-log-maxsize=100"
                - "--service-account-extend-token-expiration=false"
                - "--advertise-address=${NODE_ADVERTISE_ADDRESS}"
                - "--allow-privileged=true"
                - "--anonymous-auth=false"
                - "--api-audiences=https://kubernetes.default.svc.cluster.local,rke2"
                - "--audit-log-maxage=30"
                - "--audit-log-maxbackup=10"
                - "--audit-log-maxsize=100"
                - "--audit-log-path=/var/log/kube-audit/audit.log"
                - "--audit-policy-file=/etc/rancher/rke2/audit-policy.yaml"
                - "--authorization-mode=Node,RBAC"
                - "--bind-address=0.0.0.0"
                - "--cert-dir=/var/lib/rancher/rke2/server/tls/temporary-certs"
                - "--client-ca-file=/var/lib/rancher/rke2/server/tls/client-ca.crt"
                - "--egress-selector-config-file=/var/lib/rancher/rke2/server/etc/egress-selector-config.yaml"
                - "--enable-admission-plugins=NodeRestriction"
                - "--enable-aggregator-routing=true"
                - "--enable-bootstrap-token-auth=true"
                - "--encryption-provider-config=/var/lib/rancher/rke2/server/cred/encryption-config.json"
                - "--encryption-provider-config-automatic-reload=true"
                - "--etcd-cafile=/var/lib/rancher/rke2/server/tls/etcd/server-ca.crt"
                - "--etcd-certfile=/var/lib/rancher/rke2/server/tls/etcd/client.crt"
                - "--etcd-keyfile=/var/lib/rancher/rke2/server/tls/etcd/client.key"
                - "--etcd-servers=https://127.0.0.1:2379"
                - "--kubelet-certificate-authority=/var/lib/rancher/rke2/server/tls/server-ca.crt"
                - "--kubelet-client-certificate=/var/lib/rancher/rke2/server/tls/client-kube-apiserver.crt"
                - "--kubelet-client-key=/var/lib/rancher/rke2/server/tls/client-kube-apiserver.key"
                - "--kubelet-preferred-address-types=InternalIP,ExternalIP,Hostname"
                - "--profiling=false"
                - "--proxy-client-cert-file=/var/lib/rancher/rke2/server/tls/client-auth-proxy.crt"
                - "--proxy-client-key-file=/var/lib/rancher/rke2/server/tls/client-auth-proxy.key"
                - "--requestheader-allowed-names=system:auth-proxy"
                - "--requestheader-client-ca-file=/var/lib/rancher/rke2/server/tls/request-header-ca.crt"
                - "--requestheader-extra-headers-prefix=X-Remote-Extra-"
                - "--requestheader-group-headers=X-Remote-Group"
                - "--requestheader-username-headers=X-Remote-User"
                - "--secure-port=6443"
                - "--service-account-issuer=https://kubernetes.default.svc.cluster.local"
                - "--service-account-key-file=/var/lib/rancher/rke2/server/tls/service.key"
                - "--service-account-signing-key-file=/var/lib/rancher/rke2/server/tls/service.current.key"
                - "--service-cluster-ip-range=10.53.0.0/16"
                - "--service-node-port-range=30000-32767"
                - "--storage-backend=etcd3"
                - "--tls-cert-file=/var/lib/rancher/rke2/server/tls/serving-kube-apiserver.crt"
                - "--tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305"
                - "--tls-private-key-file=/var/lib/rancher/rke2/server/tls/serving-kube-apiserver.key"
            mounts:
              policy: exact
              rules:
                - {destination: "/etc/ca-certificates", kind: host, source: "/etc/ca-certificates"}
                - {destination: "/etc/rancher/rke2/audit-policy.yaml", kind: host, source: "/etc/rancher/rke2/audit-policy.yaml", readOnly: true}
                - {destination: "/etc/rancher/rke2/psa-config.yaml", kind: host, source: "/etc/rancher/rke2/psa-config.yaml", readOnly: true}
                - {destination: "/etc/ssl/certs", kind: host, source: "/etc/ssl/certs"}
                - {destination: "/usr/local/share/ca-certificates", kind: host, source: "/usr/local/share/ca-certificates"}
                - {destination: "/usr/share/ca-certificates", kind: host, source: "/usr/share/ca-certificates"}
                - {destination: "/var/lib/rancher/rke2/server", kind: host, source: "/var/lib/rancher/rke2/server"}
                - {destination: "/var/lib/rancher/rke2/server/db/etcd/name", kind: host, source: "/var/lib/rancher/rke2/server/db/etcd/name", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/etc/egress-selector-config.yaml", kind: host, source: "/var/lib/rancher/rke2/server/etc/egress-selector-config.yaml", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-auth-proxy.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-auth-proxy.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-auth-proxy.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-auth-proxy.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-ca.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-kube-apiserver.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-kube-apiserver.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-kube-apiserver.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-kube-apiserver.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/client.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/client.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/client.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/client.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/server-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/server-ca.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/request-header-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/request-header-ca.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/server-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/server-ca.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/service.current.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/service.current.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/service.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/service.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/serving-kube-apiserver.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/serving-kube-apiserver.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/serving-kube-apiserver.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/serving-kube-apiserver.key", readOnly: true}
                - {destination: "/var/log/kube-audit", kind: host, source: "/var/log/kube-audit"}
      # RKE2 static pod (servers).
      kube-controller-manager:
        containers:
          - digest: "sha256:c8e5263407ac439de1dcdde98c7623efb9e17050715a80259d8bd5e81b5a9289"
            image: "docker.io/rancher/hardened-kubernetes:v1.36.4-rke2r1-build20260821"
            command: {policy: exact, argv: ["kube-controller-manager"]}
            args:
              policy: exact
              argv:
                - "--permit-port-sharing=true"
                - "--flex-volume-plugin-dir=/var/lib/kubelet/volumeplugins"
                - "--terminated-pod-gc-threshold=1000"
                - "--allocate-node-cidrs=true"
                - "--authentication-kubeconfig=/var/lib/rancher/rke2/server/cred/controller.kubeconfig"
                - "--authorization-kubeconfig=/var/lib/rancher/rke2/server/cred/controller.kubeconfig"
                - "--bind-address=127.0.0.1"
                - "--cluster-cidr=10.52.0.0/16"
                - "--cluster-signing-kube-apiserver-client-cert-file=/var/lib/rancher/rke2/server/tls/client-ca.nochain.crt"
                - "--cluster-signing-kube-apiserver-client-key-file=/var/lib/rancher/rke2/server/tls/client-ca.key"
                - "--cluster-signing-kubelet-client-cert-file=/var/lib/rancher/rke2/server/tls/client-ca.nochain.crt"
                - "--cluster-signing-kubelet-client-key-file=/var/lib/rancher/rke2/server/tls/client-ca.key"
                - "--cluster-signing-kubelet-serving-cert-file=/var/lib/rancher/rke2/server/tls/server-ca.nochain.crt"
                - "--cluster-signing-kubelet-serving-key-file=/var/lib/rancher/rke2/server/tls/server-ca.key"
                - "--cluster-signing-legacy-unknown-cert-file=/var/lib/rancher/rke2/server/tls/server-ca.nochain.crt"
                - "--cluster-signing-legacy-unknown-key-file=/var/lib/rancher/rke2/server/tls/server-ca.key"
                - "--configure-cloud-routes=false"
                - "--controllers=*,tokencleaner,-service,-route,-cloud-node-lifecycle"
                - "--kubeconfig=/var/lib/rancher/rke2/server/cred/controller.kubeconfig"
                - "--profiling=false"
                - "--root-ca-file=/var/lib/rancher/rke2/server/tls/server-ca.crt"
                - "--secure-port=10257"
                - "--service-account-private-key-file=/var/lib/rancher/rke2/server/tls/service.current.key"
                - "--service-cluster-ip-range=10.53.0.0/16"
                - "--tls-cert-file=/var/lib/rancher/rke2/server/tls/kube-controller-manager/kube-controller-manager.crt"
                - "--tls-private-key-file=/var/lib/rancher/rke2/server/tls/kube-controller-manager/kube-controller-manager.key"
                - "--use-service-account-credentials=true"
            mounts:
              policy: exact
              rules:
                - {destination: "/etc/ca-certificates", kind: host, source: "/etc/ca-certificates"}
                - {destination: "/etc/ssl/certs", kind: host, source: "/etc/ssl/certs"}
                - {destination: "/usr/local/share/ca-certificates", kind: host, source: "/usr/local/share/ca-certificates"}
                - {destination: "/usr/share/ca-certificates", kind: host, source: "/usr/share/ca-certificates"}
                - {destination: "/var/lib/rancher/rke2/server/cred/controller.kubeconfig", kind: host, source: "/var/lib/rancher/rke2/server/cred/controller.kubeconfig", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/db/etcd/name", kind: host, source: "/var/lib/rancher/rke2/server/db/etcd/name", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-ca.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-ca.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-ca.nochain.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-ca.nochain.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-controller.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-controller.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-controller.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-controller.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/kube-controller-manager/kube-controller-manager.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/kube-controller-manager/kube-controller-manager.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/kube-controller-manager/kube-controller-manager.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/kube-controller-manager/kube-controller-manager.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/server-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/server-ca.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/server-ca.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/server-ca.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/server-ca.nochain.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/server-ca.nochain.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/service.current.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/service.current.key", readOnly: true}
      # RKE2 static pod (servers).
      kube-scheduler:
        containers:
          - digest: "sha256:c8e5263407ac439de1dcdde98c7623efb9e17050715a80259d8bd5e81b5a9289"
            image: "docker.io/rancher/hardened-kubernetes:v1.36.4-rke2r1-build20260821"
            command: {policy: exact, argv: ["kube-scheduler"]}
            args:
              policy: exact
              argv:
                - "--permit-port-sharing=true"
                - "--authentication-kubeconfig=/var/lib/rancher/rke2/server/cred/scheduler.kubeconfig"
                - "--authorization-kubeconfig=/var/lib/rancher/rke2/server/cred/scheduler.kubeconfig"
                - "--bind-address=127.0.0.1"
                - "--kubeconfig=/var/lib/rancher/rke2/server/cred/scheduler.kubeconfig"
                - "--profiling=false"
                - "--secure-port=10259"
                - "--tls-cert-file=/var/lib/rancher/rke2/server/tls/kube-scheduler/kube-scheduler.crt"
                - "--tls-private-key-file=/var/lib/rancher/rke2/server/tls/kube-scheduler/kube-scheduler.key"
            mounts:
              policy: exact
              rules:
                - {destination: "/var/lib/rancher/rke2/server/cred/scheduler.kubeconfig", kind: host, source: "/var/lib/rancher/rke2/server/cred/scheduler.kubeconfig", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/db/etcd/name", kind: host, source: "/var/lib/rancher/rke2/server/db/etcd/name", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-scheduler.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-scheduler.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-scheduler.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-scheduler.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/kube-scheduler/kube-scheduler.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/kube-scheduler/kube-scheduler.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/kube-scheduler/kube-scheduler.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/kube-scheduler/kube-scheduler.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/server-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/server-ca.crt", readOnly: true}
      # RKE2 static pod (servers).
      cloud-controller-manager:
        containers:
          - digest: "sha256:95a33533d97b10502be19e4f3e60e7ce9c30f4879084709af96259a01253f044"
            image: "docker.io/rancher/rke2-cloud-provider:v1.36.4-0.20260817193921-a2fc9574e060-build20260820"
            command: {policy: exact, argv: ["cloud-controller-manager"]}
            args:
              policy: exact
              argv:
                - "--allocate-node-cidrs=true"
                - "--authentication-kubeconfig=/var/lib/rancher/rke2/server/cred/cloud-controller.kubeconfig"
                - "--authorization-kubeconfig=/var/lib/rancher/rke2/server/cred/cloud-controller.kubeconfig"
                - "--bind-address=127.0.0.1"
                - "--cloud-config=/var/lib/rancher/rke2/server/etc/cloud-config.yaml"
                - "--cloud-provider=rke2"
                - "--cluster-cidr=10.52.0.0/16"
                - "--configure-cloud-routes=false"
                - "--controllers=*,-route,-service"
                - "--kubeconfig=/var/lib/rancher/rke2/server/cred/cloud-controller.kubeconfig"
                - "--leader-elect-resource-name=rke2-cloud-controller-manager"
                - "--node-status-update-frequency=1m0s"
                - "--profiling=false"
            mounts:
              policy: exact
              rules:
                - {destination: "/etc/ca-certificates", kind: host, source: "/etc/ca-certificates"}
                - {destination: "/etc/ssl/certs", kind: host, source: "/etc/ssl/certs"}
                - {destination: "/usr/local/share/ca-certificates", kind: host, source: "/usr/local/share/ca-certificates"}
                - {destination: "/usr/share/ca-certificates", kind: host, source: "/usr/share/ca-certificates"}
                - {destination: "/var/lib/rancher/rke2/server/cred/cloud-controller.kubeconfig", kind: host, source: "/var/lib/rancher/rke2/server/cred/cloud-controller.kubeconfig", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/etc/cloud-config.yaml", kind: host, source: "/var/lib/rancher/rke2/server/etc/cloud-config.yaml", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-rke2-cloud-controller.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-rke2-cloud-controller.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/client-rke2-cloud-controller.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/client-rke2-cloud-controller.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/server-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/server-ca.crt", readOnly: true}
      # RKE2 static pod (servers).
      etcd:
        containers:
          - digest: "sha256:4f7ffbb3399c9f8137f5d0dd3ca0eddc7909e5d0155b35f1b0449baf96d61bfa"
            image: "docker.io/rancher/hardened-etcd:v3.6.14-k3s1-build20260819"
            command: {policy: exact, argv: ["etcd"]}
            args:
              policy: exact
              argv:
                - "--config-file=/var/lib/rancher/rke2/server/db/etcd/config"
            mounts:
              policy: exact
              rules:
                - {destination: "/var/lib/rancher/rke2/server/db/etcd", kind: host, source: "/var/lib/rancher/rke2/server/db/etcd"}
                - {destination: "/var/lib/rancher/rke2/server/db/etcd/config", kind: host, source: "/var/lib/rancher/rke2/server/db/etcd/config", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/peer-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/peer-ca.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/peer-server-client.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/peer-server-client.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/peer-server-client.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/peer-server-client.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/server-ca.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/server-ca.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/server-client.crt", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/server-client.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/server/tls/etcd/server-client.key", kind: host, source: "/var/lib/rancher/rke2/server/tls/etcd/server-client.key", readOnly: true}
      # RKE2 static pod (every node).
      kube-proxy:
        containers:
          - digest: "sha256:c8e5263407ac439de1dcdde98c7623efb9e17050715a80259d8bd5e81b5a9289"
            image: "docker.io/rancher/hardened-kubernetes:v1.36.4-rke2r1-build20260821"
            command: {policy: exact, argv: ["kube-proxy"]}
            args:
              policy: exact
              argv:
                - "--cluster-cidr=10.52.0.0/16"
                - "--conntrack-max-per-core=0"
                - "--conntrack-tcp-timeout-close-wait=0s"
                - "--conntrack-tcp-timeout-established=0s"
                - "--healthz-bind-address=127.0.0.1"
                - "--hostname-override=${NODE_NAME}"
                - "--iptables-localhost-nodeports=false"
                - "--kubeconfig=/var/lib/rancher/rke2/agent/kubeproxy.kubeconfig"
                - "--proxy-mode=iptables"
            mounts:
              policy: exact
              rules:
                - {destination: "/var/lib/rancher/rke2/agent/client-kube-proxy.crt", kind: host, source: "/var/lib/rancher/rke2/agent/client-kube-proxy.crt", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/agent/client-kube-proxy.key", kind: host, source: "/var/lib/rancher/rke2/agent/client-kube-proxy.key", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/agent/kubeproxy.kubeconfig", kind: host, source: "/var/lib/rancher/rke2/agent/kubeproxy.kubeconfig", readOnly: true}
                - {destination: "/var/lib/rancher/rke2/agent/server-ca.crt", kind: host, source: "/var/lib/rancher/rke2/agent/server-ca.crt", readOnly: true}
      # The Cilium agent DaemonSet: its init containers and the agent.
      cilium:
        initContainers:
          - digest: "sha256:0d26512c90d935db3180f47a7a716e3dfac0847ec29076fb5487e535125a86a8"
            image: "docker.io/rancher/hardened-cni-plugins:v1.9.1-build20260717"
            command: {policy: exact, argv: ["./install-cnis.sh"]}
            args: {policy: deny}
            mounts:
              policy: exact
              rules:
                - {destination: "/host/opt/cni/bin", kind: host, source: "/opt/cni/bin"}
          - digest: "sha256:134ab48d00e67bed72fa43e0492adf2f0c78383e21da7ee1aeb5b7aa8ef2e7ee"
            image: "docker.io/rancher/mirrored-cilium-cilium:v1.19.6"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
        containers:
          - digest: "sha256:134ab48d00e67bed72fa43e0492adf2f0c78383e21da7ee1aeb5b7aa8ef2e7ee"
            image: "docker.io/rancher/mirrored-cilium-cilium:v1.19.6"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      cilium-operator:
        containers:
          - digest: "sha256:aadc3b1a2b8b682f5b4f7b01e182eeeac16f1177af0561b07825abab1d654b2b"
            image: "docker.io/rancher/mirrored-cilium-operator-generic:v1.19.6"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      coredns:
        containers:
          - digest: "sha256:e9435ef6526a98e8d01d98a85d23770859ca49028ebd282912ae5e76f92c0166"
            image: "docker.io/rancher/hardened-coredns:v1.14.7-build20260819"
            command: {policy: exact, argv: ["/coredns"]}
            args: {policy: exact, argv: ["-conf", "/etc/coredns/Corefile"]}
            mounts: {policy: any}
      # CoreDNS's replica autoscaler.
      coredns-autoscaler:
        containers:
          - digest: "sha256:c9b9b027e4d2cf1731311f9714f4aa633d37d7b0a72c9d3e6fc7a0594350d27c"
            image: "docker.io/rancher/hardened-cluster-autoscaler:v1.10.3-build20260819"
            command: {policy: exact, argv: ["/cluster-proportional-autoscaler"]}
            args:
              policy: exact
              argv:
                - "--namespace=kube-system"
                - "--configmap=rke2-coredns-rke2-coredns-autoscaler"
                - "--target=Deployment/rke2-coredns-rke2-coredns"
                - "--logtostderr=true"
                - "--v=2"
            mounts: {policy: deny}
      metrics-server:
        containers:
          - digest: "sha256:4935e86e846d75591113f64ad4e0402718a1eda08f6900a9325d54f1df64945c"
            image: "docker.io/rancher/hardened-k8s-metrics-server:v0.9.0-build20260819"
            command: {policy: exact, argv: ["/metrics-server"]}
            args:
              policy: exact
              argv:
                - "--secure-port=10250"
                - "--cert-dir=/tmp"
                - "--kubelet-preferred-address-types=InternalIP,ExternalIP,Hostname"
                - "--kubelet-use-node-status-port"
                - "--metric-resolution=15s"
            mounts:
              policy: exact
              rules:
                - {destination: "/tmp", kind: emptyDir, source: "tmp"}
      # The volume snapshot controller.
      snapshot-controller:
        containers:
          - digest: "sha256:8d5872d767f93393273cb1ecad81e4bc08af65311d206bc31ee8f48bc58e51c4"
            image: "docker.io/rancher/hardened-snapshot-controller:v8.6.0-build20260819"
            command: {policy: exact, argv: ["/snapshot-controller"]}
            args:
              policy: exact
              argv:
                - "--feature-gates=CSIVolumeGroupSnapshot=true"
                - "--http-endpoint=:8080"
                - "--leader-election=true"
                - "--leader-election-namespace=kube-system"
            mounts: {policy: deny}
      # The jobs that install RKE2's charts.
      helm-install:
        containers:
          - digest: "sha256:ba922718d919920b6b6168e3f55f8effa85032a38bf44d8cc5f4df79a2fe405d"
            image: "docker.io/rancher/klipper-helm:v0.13.3-build20260820"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      # From the baked server/manifests/local-path-storage.yaml.
      local-path-provisioner:
        containers:
          - digest: "sha256:1eba82e9c386038b4af6d69cca7519fac738c28c42735ed48ce70c882ad0d80f"
            image: "rancher/local-path-provisioner:v0.0.36@sha256:1eba82e9c386038b4af6d69cca7519fac738c28c42735ed48ce70c882ad0d80f"
            command: {policy: exact, argv: ["local-path-provisioner"]}
            args: {policy: exact, argv: ["--debug", "start", "--config", "/mnt/c8s-data/local-path-config/config.json"]}
            mounts:
              policy: exact
              rules:
                - {destination: "/mnt/c8s-data/local-path-config", kind: data, source: "config-volume"}
            env:
              policy: match
              variables:
                # containerd's, and the kubelet's for the default namespace's kubernetes Service.
                HOSTNAME: {present: true}
                KUBERNETES_SERVICE_HOST: {present: true}
                KUBERNETES_SERVICE_PORT: {exact: "443"}
                KUBERNETES_SERVICE_PORT_HTTPS: {exact: "443"}
                KUBERNETES_PORT: {present: true}
                KUBERNETES_PORT_443_TCP: {present: true}
                KUBERNETES_PORT_443_TCP_ADDR: {present: true}
                KUBERNETES_PORT_443_TCP_PORT: {exact: "443"}
                KUBERNETES_PORT_443_TCP_PROTO: {exact: "tcp"}
                # The image's (`crane config` of the digest above).
                PATH: {exact: "/go/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"}
                GOLANG_VERSION: {exact: "1.26.3"}
                GOTOOLCHAIN: {exact: "local"}
                GOPATH: {exact: "/go"}
                # The manifest's.
                POD_NAMESPACE: {present: true}
                CONFIG_MOUNT_PATH: {exact: "/mnt/c8s-data/local-path-config"}
      # GPU nodes, from the baked server/manifests/nvidia-device-plugin.yaml.
      nvidia-device-plugin:
        containers:
          - digest: "sha256:25cc340fe6fd53c101e16fc452f503e7a92c219c64a80ed5381784b522dbbf77"
            image: "nvcr.io/nvidia/k8s-device-plugin:v0.19.3@sha256:25cc340fe6fd53c101e16fc452f503e7a92c219c64a80ed5381784b522dbbf77"
            command: {policy: exact, argv: ["nvidia-device-plugin"]}
            args: {policy: deny}
            mounts:
              policy: exact
              rules:
                - {destination: "/dev", kind: host, source: "/dev"}
                - {destination: "/driver-root/etc", kind: host, source: "/etc", readOnly: true}
                - {destination: "/driver-root/usr", kind: host, source: "/usr", readOnly: true}
                - {destination: "/var/lib/kubelet/device-plugins", kind: host, source: "/var/lib/kubelet/device-plugins"}
                - {destination: "/var/run/cdi", kind: host, source: "/var/run/cdi"}
            env:
              policy: match
              variables:
                # containerd's, and the kubelet's for the default namespace's kubernetes Service.
                HOSTNAME: {present: true}
                KUBERNETES_SERVICE_HOST: {present: true}
                KUBERNETES_SERVICE_PORT: {exact: "443"}
                KUBERNETES_SERVICE_PORT_HTTPS: {exact: "443"}
                KUBERNETES_PORT: {present: true}
                KUBERNETES_PORT_443_TCP: {present: true}
                KUBERNETES_PORT_443_TCP_ADDR: {present: true}
                KUBERNETES_PORT_443_TCP_PORT: {exact: "443"}
                KUBERNETES_PORT_443_TCP_PROTO: {exact: "tcp"}
                # The image's (`crane config` of the digest above).
                PATH: {exact: "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/busybox"}
                SSL_CERT_FILE: {exact: "/etc/ssl/certs/ca-certificates.crt"}
                OPENSSL_CONF: {exact: "/etc/ssl/openssl-nofips.cnf"}
                OPENSSL_MODULES: {exact: "/usr/lib/x86_64-linux-gnu/ossl-modules/"}
                LD_LIBRARY_PATH: {exact: "/lib/distroless/"}
                NVIDIA_DISABLE_REQUIRE: {exact: "true"}
                NVIDIA_DRIVER_CAPABILITIES: {exact: "compute,utility"}
                # The manifest's, NVIDIA_VISIBLE_DEVICES replacing the image's.
                NVIDIA_VISIBLE_DEVICES: {exact: "all"}
                FAIL_ON_INIT_ERROR: {exact: "false"}
                DEVICE_LIST_STRATEGY: {exact: "cdi-annotations"}
                DEVICE_ID_STRATEGY: {exact: "uuid"}
                NVIDIA_DRIVER_ROOT: {exact: "/"}
                CONTAINER_DRIVER_ROOT: {exact: "/driver-root"}
                CDI_FEATURE_FLAGS: {exact: "disable-ipc-discoverer"}
      # END rke2 system images
      # The platform roles the enforcer grants inside a member pod. A role
      # comes from this measured base alone: the JSON ingest drops the field,
      # so a document CDS serves can never claim one (pkg/allowlist).
      #
      # INVARIANT: every command, and every exact args and mounts policy, is
      # what the injector builds for that container over the image's
      # entrypoint (internal/webhook, TestMeasuredBaseAdmitsTheInjectedArgv).
      # An args or mounts policy is any only where the pod chooses them.
      c8s-mesh-endpoint:
        label: "armtls-mesh"
        containers:
          - digest: "@MESH_DIGEST@"
            image: "@MESH_REPO@@@MESH_DIGEST@"
            role: "mesh"
            command: {policy: exact, argv: ["/app/c8s", "armtls-mesh"]}
            args:
              policy: exact
              argv:
                - "--cert-path=/etc/c8s/certs/tls.crt"
                - "--key-path=/etc/c8s/certs/tls.key"
                - "--ca-path=/etc/c8s/certs/ca.crt"
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
      # The credential clients come in two shapes: the injected one, whose
      # volumes are the pod's own business, and the router pod's, whose mount
      # set is pinned because a pod of that namespace runs a role container
      # only under a declaration that pins it (the credentials of that pod are
      # separated by mount set alone).
      c8s-get-cert:
        label: "c8s get-cert"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "get-cert"]}
            # Per pod: the SAN it requests and the discovery files it writes.
            args: {policy: any}
            mounts: {policy: any}
          # The router pod's certificate sidecar: the member credential it
          # writes, the discovery file it publishes, the launch-signed SAN it
          # reads and the node inventory it redeems its token at.
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "get-cert"]}
            args: {policy: any}
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
                - destination: "/discovery"
                  kind: "emptyDir"
                  source: "discovery"
                - destination: "/run/c8s-node"
                  kind: "host"
                  source: "/run/c8s-node"
                  readOnly: true
                - destination: "/run/c8s/workload-claims"
                  kind: "host"
                  source: "/run/nri-image-policy"
                  readOnly: true
          # The webpki front door's sidecar reads the Secret as well, which it
          # reports in the discovery document.
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "get-cert"]}
            args: {policy: any}
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
                - destination: "/discovery"
                  kind: "emptyDir"
                  source: "discovery"
                - destination: "/mnt/c8s-data/public-tls"
                  kind: "data"
                  source: "public-tls"
                - destination: "/run/c8s-node"
                  kind: "host"
                  source: "/run/c8s-node"
                  readOnly: true
                - destination: "/run/c8s/workload-claims"
                  kind: "host"
                  source: "/run/nri-image-policy"
                  readOnly: true
      c8s-probe-file:
        label: "c8s probe-file"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "probe-file"]}
            args: {policy: exact, argv: ["--wait", "--timeout=3m0s", "/etc/c8s/certs/tls.crt"]}
            # Per pod: the discovery volume get-cert writes.
            mounts: {policy: any}
          # The router pod's gate waits on the member credential and holds
          # nothing else.
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "probe-file"]}
            args: {policy: exact, argv: ["--wait", "--timeout=3m0s", "/etc/c8s/certs/tls.crt"]}
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
      c8s-get-secret:
        label: "c8s get-secret"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "get-secret"]}
            # Per pod: the secrets it fetches and where they land.
            args: {policy: any}
            mounts: {policy: any}
      c8s-get-volume:
        label: "c8s get-volume"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "get-volume"]}
            # Per pod: the volumes it opens and where they are mounted.
            args: {policy: any}
            mounts: {policy: any}
      # The router's own containers. The chart renders its pod itself, and
      # every pod of the router namespace holds platform-role containers
      # only, so each of them takes a role from here. The router
      # role serves the front door's ports; the upstream role reaches the
      # cluster's members, as the mesh client of the workload each route
      # names; the acme role is the one that reaches outside the cluster in
      # the clear; the credentials role reaches the node's CDS.
      c8s-router-nginx:
        label: "nginx reload"
        containers:
          - digest: "@ROUTER_DIGEST@"
            image: "@ROUTER_REPO@@@ROUTER_DIGEST@"
            role: "router"
            command: {policy: exact, argv: ["/bin/sh", "/usr/lib/c8s/router-nginx/reload.sh"]}
            args: {policy: deny}
            # The credentials it serves, its measured configuration directory
            # and the scratch it writes. A front door mounting anything else
            # is refused, so no other volume of this pod reaches it.
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
                - destination: "/etc/c8s-acme-tls"
                  kind: "emptyDir"
                  source: "acme-tls"
                - destination: "/etc/c8s-acme-key"
                  kind: "emptyDir"
                  source: "acme-key"
                - destination: "/discovery"
                  kind: "emptyDir"
                  source: "discovery"
                - destination: "/var/cache/nginx"
                  kind: "emptyDir"
                  source: "nginx-cache"
                - destination: "/tmp"
                  kind: "emptyDir"
                  source: "nginx-tmp"
                - destination: "/var/lib/c8s-tunnel-body"
                  kind: "emptyDir"
                  source: "nginx-tunnel-body"
                - destination: "/usr/lib/c8s/router-nginx"
                  kind: "host"
                  source: "/usr/lib/c8s/router-nginx"
                  readOnly: true
                - destination: "/run/c8s-node"
                  kind: "host"
                  source: "/run/c8s-node"
                  readOnly: true
      c8s-acme:
        label: "c8s acme"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "acme"
            command: {policy: exact, argv: ["/c8s", "acme"]}
            # Per cluster: the domains it proves, the ACME directory it uses
            # and the account it registers.
            args: {policy: any}
            # Its own leaf's volumes, the member credential it stands by for
            # and the node's launch inputs: the ACME key is the one credential
            # this role mints for itself, and it is written apart from the
            # chain so a reader of the chain never holds it.
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s-acme-tls"
                  kind: "emptyDir"
                  source: "acme-tls"
                - destination: "/etc/c8s-acme-key"
                  kind: "emptyDir"
                  source: "acme-key"
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
                - destination: "/run/c8s-node"
                  kind: "host"
                  source: "/run/c8s-node"
                  readOnly: true
      # The pod's route authority: it holds the signed route manifest and
      # dials the member each route names as a mesh client, so it runs as the
      # upstream identity, the one this pod's ruleset leaves uncaptured into
      # the cluster. It binds the leaf the front door presents, so it mounts
      # the chain and never the key beside it.
      c8s-router-upstream:
        label: "c8s cds-attest"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "upstream"
            command: {policy: exact, argv: ["/c8s", "cds-attest"]}
            # Per cluster: the upstream it fronts and the leaf it binds.
            args: {policy: any}
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
                - destination: "/run/nri-image-policy"
                  kind: "host"
                  source: "/run/nri-image-policy"
                  readOnly: true
                - destination: "/run/c8s-node"
                  kind: "host"
                  source: "/run/c8s-node"
                  readOnly: true
          # The webpki front door's attestation sidecar reads the Secret the
          # front door serves.
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "upstream"
            command: {policy: exact, argv: ["/c8s", "cds-attest"]}
            args: {policy: any}
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
                - destination: "/mnt/c8s-data/public-tls"
                  kind: "data"
                  source: "public-tls"
                - destination: "/run/nri-image-policy"
                  kind: "host"
                  source: "/run/nri-image-policy"
                  readOnly: true
                - destination: "/run/c8s-node"
                  kind: "host"
                  source: "/run/c8s-node"
                  readOnly: true
          # The acme front door's attestation sidecar reads that leaf as well.
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "upstream"
            command: {policy: exact, argv: ["/c8s", "cds-attest"]}
            args: {policy: any}
            mounts:
              policy: exact
              rules:
                - destination: "/etc/c8s/certs"
                  kind: "emptyDir"
                  source: "c8s-certs"
                - destination: "/etc/c8s-acme-tls"
                  kind: "emptyDir"
                  source: "acme-tls"
                - destination: "/run/nri-image-policy"
                  kind: "host"
                  source: "/run/nri-image-policy"
                  readOnly: true
                - destination: "/run/c8s-node"
                  kind: "host"
                  source: "/run/c8s-node"
                  readOnly: true
      c8s-allowlist-proxy:
        label: "c8s allowlist-proxy"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_REPO@@@OPERATOR_DIGEST@"
            role: "credentials"
            command: {policy: exact, argv: ["/c8s", "allowlist-proxy"]}
            # Per cluster: the port it listens on.
            args: {policy: any}
            # The node's own inventory socket directory, which is where it
            # reaches the verifier it dials CDS through.
            mounts:
              policy: exact
              rules:
                - destination: "/run/c8s/workload-claims"
                  kind: "host"
                  source: "/run/nri-image-policy"
                  readOnly: true
  pull:
    # Authenticated launch staging replaces this endpoint with the server's
    # CDS URL. The pull loop retries while the baked CDS service starts;
    # the plugin stays Ready on the base allowlist above.
    url: "https://127.0.0.1:30808"
    # INVARIANT: equal to the chart's nriImagePolicy.refresh.interval.
    interval: "5s"
    timeout: "30s"
    attestation_api_url: "http://127.0.0.1:8400"
    cds_measurements_config: "/run/confos/launch/cds.json"
    # measure_policies (extend RTMR[3] with each pulled allowlist) is off
    # here; the chart's pins installer patches it from
    # nriImagePolicy.measurePolicies.

# The measured mesh policy: what a member pod's packet ruleset is built from,
# and the identity each platform role runs as. The enforcer requires it
# (internal/cmds/nri-image-policy/config.go).
mesh:
  # These namespaces keep the node's own rules: they run the node's trusted
  # components, which need host privileges a member pod may not hold (volumed
  # needs SYS_ADMIN) and hold no credential to ride the mesh with.
  exempt_namespaces:
    - kube-system
    - c8s-system
    # The baked RKE2 addon, whose helper pod writes a host path as root
    # (mkosi.extra/var/lib/rancher/rke2/server/manifests/local-path-storage.yaml).
    - local-path-storage
  # INVARIANT: equal to cluster-dns in etc/rancher/rke2/config.yaml. A
  # config.yaml.d drop-in that moves the cluster DNS breaks name resolution in
  # member pods closed, never open.
  resolver: "10.53.0.10"
  # This cluster's pod and Service ranges. The acme role of the router's
  # namespace is the one identity whose sockets leave the cluster in the clear,
  # and its exception excludes these ranges, so a dial to a member is captured
  # and rides the mesh like any other application connection.
  #
  # INVARIANT: equal to cluster-cidr and service-cidr in
  # etc/rancher/rke2/config.yaml.
  cluster_ranges: ["10.52.0.0/16", "10.53.0.0/16"]
  # INVARIANT: equal to the ports the injected endpoint binds
  # (pkg/workloadclaims.Mesh*Port).
  capture:
    outbound: 15001
    inbound: 15006
    health: 15021
  # The mesh endpoint holds no capabilities: the enforcer installs the pod
  # ruleset, so the endpoint only proxies. Boot preparation adds the
  # credential role, whose destination is the staged CDS address
  # (internal/cmds/nodeservices).
  roles:
    - name: mesh
      uid: 1337

containerd:
  socket: "/run/k3s/containerd/containerd.sock"
  namespace: "k8s.io"

policy:
  mode: "fail-closed"
  enforce_existing: true
  deny_missing_annotation: true
  # A container already running when the plugin first registers means one ran
  # before admission existed — the plugin is pre-registered in containerd's
  # config and required_plugins blocks creation while it is absent, so in a
  # valid boot the set is empty. It has already executed by then, so the node
  # powers off rather than stopping it.
  #
  # A plugin restart is not that event: containerd stays up and its containers
  # legitimately predate the new process. The marker below is on tmpfs, so it
  # separates the two, and a restart re-checks what is running against the
  # allowlist instead.
  fatal_existing: true
  boot_marker_path: "/run/nri-image-policy/registered"
  #
  # Host privilege outside the node TCB: host namespaces, host bind mounts,
  # devices, CDI injection, OCI hooks and the marks of a privileged container
  # (see docs/allowlist-and-capabilities.md, "Host privilege").
  #
  # AUDIT, not enforce, and this is the one thing to flip: C8s's own node-level
  # components (volumed, armtls-mesh, the attestation-api proxy, router, the
  # nri-image-policy installer) legitimately use hostPath and hostNetwork, and
  # they reach this plugin through the CDS-served document rather than through
  # the base above, so enforcing today would deny them. Resolve their digests
  # into the measured base the way boot preparation already merges the
  # chart-derived component seed, then set this to "enforce".
  sandbox: "audit"
  label_rules: []

logging:
  level: "info"
  # containerd starts a pre-installed plugin with its standard streams on
  # /dev/null; journald's socket keeps the denials and audit records.
  syslog: "/dev/log"
