# Fail the boot unless every passed-through NVIDIA GPU is in CC mode and
# attests. confos's nvidia-cc-ready deliberately tolerates non-CC launches
# and sets the CC Ready state without any verification; the C8s node must
# do neither, so this unit runs first and nvidia-cc-ready Requires it.
[Unit]
Description=Refuse to start the node unless every NVIDIA GPU is in confidential-compute mode and attests
# The driver must be resident (persistenced) and the baked attestation-api
# reachable; both are Wants, not Requires, so a GPU-less boot of a
# composition without them is a no-op. Egress is needed for NRAS.
# The NRAS token carries nbf=now. A CVM boots with an unsynchronised clock,
# so attestation must not run until time-sync.target is reached, otherwise
# /verify fails with 'JWT is not yet valid (nbf)' and FailureAction powers
# the node off. Measured on b200-dev-1: GPUs pass the CC-mode check, then
# /verify returns 422 on nbf.
After=nvidia-persistenced.service attestation-api.service network-online.target time-sync.target
Wants=nvidia-persistenced.service attestation-api.service network-online.target time-sync.target
Before=nvidia-cc-ready.service rke2-server.service rke2-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gpu-cc-enforce.sh
# Driver wait (180s) + attestation-api wait (60s) + one attest/verify round
# trip through NRAS, with headroom.
TimeoutStartSec=420
# Fail closed: a non-CC or unattested GPU powers the VM off rather than
# leaving a node that schedules unprotected GPU memory.
FailureAction=poweroff-force

# vsock fence: only attestation-api may use AF_VSOCK (see kernel/gpu.config).
# INET is for the loopback attestation-api endpoint.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
# Preset creates the .requires links, so neither the Ready-state flip nor
# rke2 can start while this unit is failing or has not run.
RequiredBy=nvidia-cc-ready.service rke2-server.service rke2-agent.service
