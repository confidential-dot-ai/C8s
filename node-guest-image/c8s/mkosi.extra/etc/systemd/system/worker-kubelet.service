# Worker role only: a kubelet joined to the cluster the signed launch document
# names. It bootstraps through c8s node-credential, which attests the node to
# CDS, and runs on the measured configuration in /usr/lib/c8s/worker-runtime.
# With an external cloud provider it registers its Node with the uninitialized
# taint, which the cluster's cloud controller manager clears when it sets the
# node's provider ID: nothing on the host names the Machine the node is.
[Unit]
Description=Worker-role kubelet
ConditionPathExists=/run/confos/role-worker
Requires=worker-containerd.service worker-node-name.service attestation-api.service
After=worker-containerd.service worker-node-name.service attestation-api.service

[Service]
Type=simple
Environment=PATH=/var/lib/rancher/rke2/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# KUBELET_HOSTNAME is the node key's name (worker-node-name.service).
EnvironmentFile=/run/c8s-worker/node-name.env
ExecStart=/var/lib/rancher/rke2/bin/kubelet \
    --config=/usr/lib/c8s/worker-runtime/kubelet.yaml \
    --config-dir=/run/c8s-worker/kubelet.conf.d \
    --bootstrap-kubeconfig=/run/c8s-worker/bootstrap-kubeconfig \
    --kubeconfig=/var/lib/kubelet/kubeconfig \
    --cert-dir=/var/lib/kubelet/pki \
    --hostname-override=${KUBELET_HOSTNAME} \
    --cloud-provider=external
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
