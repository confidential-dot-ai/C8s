[Unit]
Description=Publish the authenticated node address for admission inventory
Requires=rke2-role.service
After=rke2-role.service
Before=rke2-server.service rke2-agent.service podcvm-containerd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/c8s node-services node-ip
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
RequiredBy=rke2-server.service rke2-agent.service podcvm-containerd.service
