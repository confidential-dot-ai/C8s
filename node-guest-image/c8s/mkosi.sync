#!/usr/bin/env bash
# mkosi sync hook for the c8s profile.
#
# Same mechanism as the attest profile's sync (see its header for the oras +
# layer-extract approach and the mkosi.local staging convention). Stages
# three pinned artifact sets into mkosi.local/mkosi.extra/:
#
#   1. RKE2 release tarball      -> usr/local/  (rke2 binary, systemd units
#      under usr/local/lib/systemd/system/ — on systemd's unit search path)
#   2. RKE2 airgap image bundles -> var/lib/rancher/rke2/agent/images/
#      Baked deliberately: the measurement then covers the exact bytes of
#      every control-plane image (kube-* static pods, Cilium, CoreDNS) and
#      the node boots with zero registry dependency. Costs ~1.6G of disk.raw.
#   3. nri-image-policy plugin   -> opt/nri/plugins/10-nri-image-policy
#
# Bumping any pin below changes the launch measurement of any
# `--profile c8s` build — intended behaviour.
#
# RKE2 pins: bump RKE2_VERSION and the three sha256s together, from
# sha256sum-amd64.txt at
#   https://github.com/rancher/rke2/releases/tag/<RKE2_VERSION>
# then regenerate the system images in image-policy.yaml.in (the bundles are
# in mkosi.pkgcache/c8s after a build):
#   go run ./node-guest-image/c8s/systemfloor -write \
#     -template node-guest-image/c8s/image-policy.yaml.in \
#     -bundle <core bundle> -bundle <cilium bundle> \
#     -manifest node-guest-image/c8s/mkosi.extra/var/lib/rancher/rke2/server/manifests/local-path-storage.yaml \
#     -manifest node-guest-image/c8s/mkosi.extra/var/lib/rancher/rke2/server/manifests/nvidia-device-plugin.yaml \
#     -exclude-ref busybox
# -exclude-ref omits busybox from the node's baked base;
# the chart supplies its argv-pinned entry through the served allowlist.
# rke2's own containerd base template imports config-v3.toml.d/*.toml since
# v1.36 (k3s b51167a9), which is where the NRI drop-in lives, so this profile
# bakes no config-v3.toml.tmpl: one that added the import produced a duplicate
# `imports` key that containerd refuses, and rke2-server never came up.
#
# The multi-command c8s binary and c8s container images resolve from one
# C8S_REF. The binary contains the complete core chart, rendered at build
# time. Its pinned images are also baked as OCI archives, so guest startup
# needs neither Helm nor a registry connection.
#
# Downloads are cached under mkosi.pkgcache/c8s/ — that dir survives across
# builds; mkosi.local does NOT (the confos Rust driver wipes it on build
# exit, see MkosiLocalCleanup in src/commands/build.rs).

set -euo pipefail

STAGE_DIR="$SRCDIR/mkosi.local/mkosi.extra"
CACHE_DIR="$SRCDIR/mkosi.pkgcache/c8s"
mkdir -p "$STAGE_DIR" "$CACHE_DIR" "${TMPDIR:=/tmp}"

# Build-only renderer, aligned with this repository's chart CI. The pinned
# Ubuntu tools snapshot does not package Helm. Checksum published at
# https://github.com/helm/helm/releases/tag/v3.14.4.
HELM_VERSION="v3.14.4"
HELM_LINUX_AMD64_SHA256="a5844ef2c38ef6ddf3b5a8f7d91e7e0e8ebc39a38bb3fc8013d629c1ef29c259"

RKE2_VERSION="v1.36.4+rke2r1"
# Where rke2 extracts the runtime image's bin dir to (a symlink to
# data/<digest>/bin, created on first start). The measured wrapper execs runc
# there by absolute path, and the dev drop-in below points containerd straight
# at it.
REAL_RUNC="/var/lib/rancher/rke2/bin/runc"
RKE2_TARBALL_SHA256="7bcbd3167d6947e1d79cdf722acdc740b28021fefb50dd5b974a1980776d4079"
RKE2_IMAGES_CORE_SHA256="8988a2eff587dd88b8eab86fe719703e9541a1f08d22771a94cbec446a13db86"
RKE2_IMAGES_CILIUM_SHA256="6c76903f258b12bc0f322bcb029247ee49544b925170d320409401beeecd41bd"

# The baked binary and Kubernetes c8s images resolve from a
# single published ref. The image must include `c8s node-image render`.
# Inputs arrive through confos's explicit sync-input files; sudo strips the
# caller's environment. c8s-registry supports private/air-gapped registries.
SYNC_INPUTS="$SRCDIR/mkosi.local/.confos-sync-inputs"
C8S_REGISTRY=$(cat "$SYNC_INPUTS/c8s-registry" 2>/dev/null || true)
C8S_REGISTRY="${C8S_REGISTRY:-ghcr.io/confidential-dot-ai}"
NRI_REPO="${C8S_REGISTRY}/nri-image-policy"
OPERATOR_REPO="${C8S_REGISTRY}/c8s-operator"
CDS_REPO="${C8S_REGISTRY}/cds"
MESH_REPO="${C8S_REGISTRY}/ratls-mesh"
# The image's TEE platform, from build's --sync-input. Required: the NRI
# base allowlist types the RA-TLS identity CDS checks against attestation
# evidence,
# so a wrong or defaulted value denies every adopted workload a certificate.
PLATFORM=$(cat "$SYNC_INPUTS/platform" 2>/dev/null || true)
case "$PLATFORM" in
    tdx|snp) ;;
    *) echo "c8s sync: FATAL platform sync-input must be tdx or snp, got '${PLATFORM}'" >&2; exit 1 ;;
esac

# Platform drop-ins rendered from the one sync-input: cred-release's
# platform and the node self-label; the NRI base allowlist's platform: is
# substituted below together with the digests. Rendered paths must stay disjoint from
# the profile's mkosi.extra tree (copy precedence between the two is
# undocumented; today every rendered path is a new file).
#
# The label key is the one consumer with its own vocabulary: the chart
# selector and c8s install use confidential.ai/sev-snp (NOT /snp — nothing
# selects on that), while cred-release and the NRI base allowlist normalize
# snp themselves (ratls.NormalizePlatform).
case "$PLATFORM" in
    snp) LABEL_PLATFORM=sev-snp ;;
    *)   LABEL_PLATFORM=$PLATFORM ;;
esac
mkdir -p "$STAGE_DIR/etc/systemd/system/cred-release.service.d" \
         "$STAGE_DIR/etc/systemd/system/c8s-join-release.service.d" \
         "$STAGE_DIR/etc/systemd/system/rke2-role.service.d" \
         "$STAGE_DIR/etc/rancher/rke2/config.yaml.d"
printf '[Service]\nEnvironment=CRED_PLATFORM=%s\n' "$PLATFORM" \
    > "$STAGE_DIR/etc/systemd/system/cred-release.service.d/10-platform.conf"
printf '[Service]\nEnvironment=CRED_PLATFORM=%s\n' "$PLATFORM" \
    > "$STAGE_DIR/etc/systemd/system/c8s-join-release.service.d/10-platform.conf"
# Authenticated role staging verifies the boot evidence for this platform
# before publishing any launch settings or role marker.
printf '[Service]\nEnvironment=CRED_PLATFORM=%s\n' "$PLATFORM" \
    > "$STAGE_DIR/etc/systemd/system/rke2-role.service.d/10-platform.conf"
printf '# Self-label so c8s install --hardware-platform %s finds this node.\nnode-label:\n  - confidential.ai/%s=true\n' "$LABEL_PLATFORM" "$LABEL_PLATFORM" \
    > "$STAGE_DIR/etc/rancher/rke2/config.yaml.d/50-platform.yaml"

# Reference copies of the guard AddOns on the read-only root. RKE2 must be
# able to write server/manifests (it stages its bundled charts there), so
# that directory lives on the writable overlay and a root process could
# shadow a guard. psa-ready.sh waits for every guard staged here and compares
# the live objects against the copy before cred-release serves; a drifted
# guard keeps :8443 closed. GUARDS is the single statement of what is a
# guard (node-guest-image-invariants.sh reads it); the profile tree is the
# single source of each: this copies, never edits.
#
# C8S_DEV=1 builds skip the baked pod-exec-policy AddOn so `kubectl exec`/
# `attach`/`port-forward` work for debugging: RKE2 ignores a server/manifests
# AddOn whose name has a `.skip` sibling, and leaving its reference copy out
# keeps psa-ready.sh from waiting for objects that never appear. The locked
# image keeps the policy (the kubelet debugging handlers are on in both
# builds, for `kubectl logs`) and has no such marker at all.
GUARDS="psa-level-policy pod-exec-policy operator-scope-policy cred-release-rbac log-reader-rbac"
GUARDS_SRC="$SRCDIR/mkosi.profiles/c8s/mkosi.extra/var/lib/rancher/rke2/server/manifests"
GUARDS_DST="$STAGE_DIR/usr/lib/confai/guards"
DEV=$(cat "$SYNC_INPUTS/dev" 2>/dev/null || true)
for guard in $GUARDS; do
    [ -f "$GUARDS_SRC/$guard.yaml" ] || { echo "c8s sync: FATAL guard AddOn $GUARDS_SRC/$guard.yaml missing" >&2; exit 1; }
    if [ "$DEV" = 1 ] && [ "$guard" = pod-exec-policy ]; then
        mkdir -p "$STAGE_DIR/var/lib/rancher/rke2/server/manifests"
        printf '# DEV build: pod-exec-policy AddOn skipped. Never ship.\n' \
            > "$STAGE_DIR/var/lib/rancher/rke2/server/manifests/$guard.yaml.skip"
        continue
    fi
    install -D -m 0444 "$GUARDS_SRC/$guard.yaml" "$GUARDS_DST/$guard.yaml"
done

if [ "$DEV" = 1 ]; then
    mkdir -p "$STAGE_DIR/var/lib/rancher/rke2/agent/etc/containerd/config-v3.toml.d"
    printf '# DEV build: unwrapped runtime, runc exec allowed. Never ship.\n[plugins."io.containerd.cri.v1.runtime".containerd.runtimes.runc.options]\n  BinaryName = "%s"\n' \
        "$REAL_RUNC" \
        > "$STAGE_DIR/var/lib/rancher/rke2/agent/etc/containerd/config-v3.toml.d/60-dev-runc.toml"
fi

C8S_REF=$(cat "$SYNC_INPUTS/c8s-ref" 2>/dev/null || true)
# Pinned c8s release: bakes the same component versions the CLI ships as.
# docker.yml publishes images under v* tags, so the tag itself is the ref.
C8S_REF="${C8S_REF:-v0.1.0-rc2}"
# c8s-binary=1: the build script pre-staged the multi-command binary at
# usr/local/bin/c8s in mkosi.local (built from a source checkout). The image
# repro gate uses this so a PR that changes the baked binary or its commands
# is gated on its own host code and chart; core container images still resolve
# from C8S_REF, which must provide the chart's commands. Published builds never set it.
C8S_PRESTAGED=$(cat "$SYNC_INPUTS/c8s-binary" 2>/dev/null || true)
C8S_TARGET="$STAGE_DIR/usr/local/bin/c8s"
if [ "$C8S_PRESTAGED" = 1 ] && [ ! -f "$C8S_TARGET" ]; then
    echo "c8s sync: FATAL c8s-binary=1 but no binary was pre-staged at ${C8S_TARGET#"$SRCDIR"/}" >&2
    exit 1
fi
if [ "$C8S_PRESTAGED" = 1 ]; then
    echo "c8s sync: using the pre-staged c8s binary; resolving core images at c8s ref ${C8S_REF}"
else
    echo "c8s sync: resolving c8s binary + core images at c8s ref ${C8S_REF}"
fi
# Resolve each c8s image from the same source ref. The nginx digest remains
# pinned by the embedded chart rather than duplicated in this script.
DIGEST_TMPDIR=$(mktemp -d)
trap 'rm -rf "$DIGEST_TMPDIR"' EXIT
resolve_digest_bg() {  # <repo> <ref> <out-file> -> writes sha256:... or FATALs
    local d
    d=$(oras manifest fetch --descriptor "$1:$2" 2>/dev/null | jq -r '.digest')
    case "$d" in
        sha256:*) printf '%s' "$d" > "$3" ;;
        *) echo "c8s sync: FATAL cannot resolve $1:$2 (is the image published? run c8s docker.yml for the branch)" >&2; exit 1 ;;
    esac
}
nri_pid=""
if [ "$C8S_PRESTAGED" = 1 ]; then
    printf 'sha256:prestaged' > "$DIGEST_TMPDIR/nri"
else
    resolve_digest_bg "$NRI_REPO" "$C8S_REF" "$DIGEST_TMPDIR/nri" &
    nri_pid=$!
fi
resolve_digest_bg "$OPERATOR_REPO" "$C8S_REF" "$DIGEST_TMPDIR/operator" &
operator_pid=$!
resolve_digest_bg "$CDS_REPO" "$C8S_REF" "$DIGEST_TMPDIR/cds" &
cds_pid=$!
resolve_digest_bg "$MESH_REPO" "$C8S_REF" "$DIGEST_TMPDIR/mesh" &
mesh_pid=$!
# Wait on every job regardless of individual exit status (a bare `wait $pid`
# chain under set -e would abort on the first failure and leave the rest
# running as orphans) — resolve_digest_bg already printed a FATAL for
# whichever repo failed; read_digest below re-checks each result file's
# shape and is what actually fails the build closed.
[ -z "$nri_pid" ] || wait "$nri_pid" || true
wait "$operator_pid" || true
wait "$cds_pid" || true
wait "$mesh_pid" || true

read_digest() {  # <name> <out-file> -> prints sha256:... or FATALs on a bad/missing result
    local d
    d=$(cat "$2" 2>/dev/null || true)
    case "$d" in
        sha256:*) printf '%s' "$d" ;;
        *) echo "c8s sync: FATAL $1 digest resolution produced '$d', want sha256:..." >&2; exit 1 ;;
    esac
}
NRI_DIGEST=$(read_digest nri "$DIGEST_TMPDIR/nri")
OPERATOR_DIGEST=$(read_digest operator "$DIGEST_TMPDIR/operator")
CDS_DIGEST=$(read_digest cds "$DIGEST_TMPDIR/cds")
MESH_DIGEST=$(read_digest mesh "$DIGEST_TMPDIR/mesh")
rm -rf "$DIGEST_TMPDIR"
trap - EXIT
NRI_IMAGE="${NRI_REPO}@${NRI_DIGEST}"
echo "c8s sync: ref ${C8S_REF} -> binary ${NRI_DIGEST}, operator ${OPERATOR_DIGEST}"

# Render the system floor. Boot preparation merges the chart's measured
# component seed into this base before RKE2/containerd starts, so CDS and
# its clients can start before the live allowlist becomes available.
render_nri_base() {
    local tmpl="$SRCDIR/mkosi.profiles/c8s/image-policy.yaml.in"
    local dst="$STAGE_DIR/usr/lib/c8s/image-policy.yaml"
    [ -f "$tmpl" ] || { echo "c8s sync: FATAL base-allowlist template $tmpl missing" >&2; exit 1; }
    mkdir -p "$(dirname "$dst")"
    sed -e "s|@PLATFORM@|${PLATFORM}|g" "$tmpl" > "$dst"
    echo "c8s sync: NRI system base allowlist rendered"
}

# Render from the chart embedded in the exact binary staged into the image.
# This command runs only in the mkosi tools tree; no Helm binary, chart archive,
# install Job or HelmChartConfig is needed by the guest boot path.
render_node_integration() {
    local out="$TMP/node-integration" helm_dir="$TMP/helm" command
    local helm_archive="$CACHE_DIR/helm-${HELM_VERSION}-linux-amd64.tar.gz"
    for command in "node-services join" join-release; do
        # shellcheck disable=SC2086 # the subcommand path is two words
        if ! "$C8S_TARGET" $command --help >/dev/null; then
            echo "c8s sync: FATAL ${C8S_REF} must provide 'c8s $command' for attested enrollment" >&2
            exit 1
        fi
    done
    fetch "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" \
        "$helm_archive" "$HELM_LINUX_AMD64_SHA256"
    mkdir -p "$helm_dir"
    tar -xzf "$helm_archive" -C "$helm_dir" linux-amd64/helm
    chmod 0755 "$helm_dir/linux-amd64/helm"
    if ! PATH="$helm_dir/linux-amd64:$PATH" "$C8S_TARGET" node-image render \
        --hardware-platform "$LABEL_PLATFORM" \
        --kube-version "${RKE2_VERSION%%+*}" \
        --image-repository "$OPERATOR_REPO" \
        --image-digest "$OPERATOR_DIGEST" \
        --cds-image-repository "$CDS_REPO" \
        --cds-image-digest "$CDS_DIGEST" \
        --ratls-mesh-image-repository "$MESH_REPO" \
        --ratls-mesh-image-digest "$MESH_DIGEST" \
        --output-dir "$out"; then
        echo "c8s sync: FATAL ${C8S_REF} must provide a working 'c8s node-image render'; publish this branch's images and select that C8S_REF" >&2
        exit 1
    fi
    # Both roles share this image. Only rke2-server applies server/manifests,
    # after authenticated launch staging selects the server role.
    install -D -m 0644 "$out/c8s-integration.yaml" \
        "$STAGE_DIR/var/lib/rancher/rke2/server/manifests/c8s-integration.yaml"
    install -D -m 0644 "$out/allowlist-seed.json" \
        "$STAGE_DIR/usr/lib/c8s/allowlist-seed.json"
    bash "$SRCDIR/mkosi.profiles/c8s/airgap-images.sh" \
        "$out/images.txt" "$CACHE_DIR/core-images" "$AIRGAP_DIR"
}

# Download <url> to <dest>, verifying its sha256. Skip if dest exists and
# already matches (this is what makes the pkgcache a cache).
fetch() {
    local url="$1" dest="$2" expected="$3" actual
    if [ -f "$dest" ]; then
        actual="$(sha256sum "$dest" | awk '{print $1}')"
        if [ "$actual" = "$expected" ]; then
            echo "c8s sync: cached ${dest##*/}"
            return
        fi
        echo "c8s sync: stale (sha mismatch), re-downloading ${dest##*/}"
        rm -f "$dest"
    fi
    echo "c8s sync: downloading $url"
    curl -fL --retry 3 --retry-delay 5 --output "$dest" "$url"
    actual="$(sha256sum "$dest" | awk '{print $1}')"
    if [ "$actual" != "$expected" ]; then
        echo "c8s sync: FATAL sha256 mismatch for ${dest##*/}" >&2
        echo "  expected: $expected" >&2
        echo "  actual:   $actual" >&2
        exit 1
    fi
}

# Place a cached artifact into the stage tree. Hardlink when possible (same
# filesystem — mkosi only reads extra trees), copy otherwise.
stage() {
    local src="$1" dest="$2"
    mkdir -p "$(dirname "$dest")"
    rm -f "$dest"
    ln "$src" "$dest" 2>/dev/null || cp "$src" "$dest"
}

# --- 1. RKE2 release tarball --------------------------------------------

VERSION_URL_SAFE="${RKE2_VERSION//+/%2B}"   # '+' must be %2B in release URLs
CACHE_VER="${RKE2_VERSION//+/-}"            # '+' unsafe in cache filenames
BASE_URL="https://github.com/rancher/rke2/releases/download/${VERSION_URL_SAFE}"

fetch "${BASE_URL}/rke2.linux-amd64.tar.gz" \
      "$CACHE_DIR/rke2-${CACHE_VER}.tar.gz" \
      "$RKE2_TARBALL_SHA256"
# Default install prefix. systemd's unit search path includes
# /usr/local/lib/systemd/system, so the bundled rke2-server/agent units
# need no relocation; the profile's 50-rke2.preset enables/disables them.
mkdir -p "$STAGE_DIR/usr/local"
tar -xzf "$CACHE_DIR/rke2-${CACHE_VER}.tar.gz" -C "$STAGE_DIR/usr/local"
chmod 0755 "$STAGE_DIR/usr/local/bin/rke2" \
           "$STAGE_DIR/usr/local/bin/rke2-killall.sh" \
           "$STAGE_DIR/usr/local/bin/rke2-uninstall.sh"
# rke2 keeps containerd on the default CNI dirs and the bundled Cilium chart
# hostPath-mounts them. Under confos's immutable root they get a writable
# overlay (state.d/60-c8s.conf), and the initrd only overlays directories
# that already exist in the image — so bake them empty here.
mkdir -p "$STAGE_DIR/opt/cni/bin" "$STAGE_DIR/etc/cni/net.d" \
         "$STAGE_DIR/etc/nri/conf.d"
# Marker for inspecting a built image.
echo "$RKE2_VERSION" > "$STAGE_DIR/usr/local/share/rke2/.confos-baked-version"

# --- 2. Airgap image bundles (core + cilium) -----------------------------

AIRGAP_DIR="$STAGE_DIR/var/lib/rancher/rke2/agent/images"
fetch "${BASE_URL}/rke2-images-core.linux-amd64.tar.zst" \
      "$CACHE_DIR/rke2-images-core-${CACHE_VER}.tar.zst" \
      "$RKE2_IMAGES_CORE_SHA256"
fetch "${BASE_URL}/rke2-images-cilium.linux-amd64.tar.zst" \
      "$CACHE_DIR/rke2-images-cilium-${CACHE_VER}.tar.zst" \
      "$RKE2_IMAGES_CILIUM_SHA256"
stage "$CACHE_DIR/rke2-images-core-${CACHE_VER}.tar.zst" \
      "$AIRGAP_DIR/rke2-images-core.linux-amd64.tar.zst"
stage "$CACHE_DIR/rke2-images-cilium-${CACHE_VER}.tar.zst" \
      "$AIRGAP_DIR/rke2-images-cilium.linux-amd64.tar.zst"

# --- 3. nri-image-policy plugin binary ------------------------------------

PLUGIN_TARGET="$STAGE_DIR/opt/nri/plugins/10-nri-image-policy"
# The same multi-command binary, also staged under its own name (C8S_TARGET,
# set above) so the cred-release systemd unit can invoke `c8s cred-release`
# (argv[0]="c8s" falls through to normal cobra dispatch — only
# get-cert/nri-image-policy/ratls-mesh are argv-aliased).
# Content-addressed by the image digest: a cached copy skips the GHCR pull
# entirely (oras digest-verifies the blobs on the pull that populates it).
PLUGIN_CACHE="$CACHE_DIR/nri-image-policy-${NRI_IMAGE##*@sha256:}"
RUNC_WRAPPER_TARGET="$STAGE_DIR/usr/local/bin/c8s-runc"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# Extract the plugin binary from the pinned nri-image-policy image into
# PLUGIN_CACHE.
extract_plugin_binary() {
    local EXTRACT="$TMP/rootfs" REPO MANIFEST CHILD LAYERS BIN TARGET
    mkdir -p "$EXTRACT"
    REPO="${NRI_IMAGE%@*}"
    MANIFEST=$(oras manifest fetch "$NRI_IMAGE")

    # The pinned digest is an OCI image index (amd64 image + provenance
    # manifest); descend to the amd64 child. Plain single-arch manifests pass
    # through unchanged so the pin can point at either form.
    case "$(echo "$MANIFEST" | jq -r '.mediaType')" in
    *.index.v1+json | *.manifest.list.v2+json)
        CHILD=$(echo "$MANIFEST" | jq -r '[.manifests[] | select(.platform.architecture == "amd64")][0].digest')
        if [ -z "$CHILD" ] || [ "$CHILD" = "null" ]; then
            echo "c8s sync: no amd64 manifest in index $NRI_IMAGE" >&2
            exit 1
        fi
        MANIFEST=$(oras manifest fetch "${REPO}@${CHILD}")
        ;;
    esac

    # Fetch every gzipped tar layer in manifest order and extract into a single
    # staging dir; later layers shadow earlier ones (same flattening containerd
    # performs). See attest/mkosi.sync for the full rationale. tar failures stay
    # loud but non-fatal (layers legitimately carry entries we can't recreate,
    # e.g. device nodes); the binary-presence check below is the gate.
    LAYERS=$(echo "$MANIFEST" | jq -r '.layers[] | select(.mediaType | test("tar.?gzip$")) | .digest')
    if [ -z "$LAYERS" ]; then
        echo "c8s sync: no tar+gzip layers in $NRI_IMAGE (zstd or unexpected media types?)" >&2
        echo "$MANIFEST" | jq -r '.layers[].mediaType' >&2
        exit 1
    fi
    echo "$LAYERS" | while read -r layer; do
        echo "c8s sync: fetching layer $layer" >&2
        oras blob fetch --output "$TMP/layer.tar.gz" "${REPO}@${layer}"
        tar -xzf "$TMP/layer.tar.gz" -C "$EXTRACT" || true
        rm -f "$TMP/layer.tar.gz"
    done

    # In the image /usr/local/bin/nri-image-policy is a symlink to the
    # multi-command c8s binary (argv[0] dispatch handles the 10- prefix, and
    # the chart installs the same content — byte-identity holds). Resolve the
    # link inside the extracted tree; absolute targets must not escape to the
    # sandbox rootfs.
    BIN="$EXTRACT/usr/local/bin/nri-image-policy"
    if [ -L "$BIN" ]; then
        TARGET=$(readlink "$BIN")
        case "$TARGET" in
            /*) BIN="$EXTRACT$TARGET" ;;
            *)  BIN="$(dirname "$BIN")/$TARGET" ;;
        esac
    fi
    if [ ! -f "$BIN" ]; then
        echo "c8s sync: nri-image-policy binary not found in image" >&2
        find "$EXTRACT" -name 'nri-image-policy*' -o -name 'c8s' >&2
        exit 1
    fi
    install -D -m 0644 "$BIN" "$PLUGIN_CACHE"
}

if [ "$C8S_PRESTAGED" = 1 ]; then
    chmod 0755 "$C8S_TARGET"
    install -D -m 0755 "$C8S_TARGET" "$PLUGIN_TARGET"
else
    if [ -f "$PLUGIN_CACHE" ]; then
        echo "c8s sync: cached nri-image-policy (${NRI_IMAGE##*@})"
    else
        extract_plugin_binary
    fi
    install -D -m 0755 "$PLUGIN_CACHE" "$PLUGIN_TARGET"
    install -D -m 0755 "$PLUGIN_CACHE" "$C8S_TARGET"
fi
install -D -m 0755 "$C8S_TARGET" "$RUNC_WRAPPER_TARGET"

render_nri_base
render_node_integration

echo "c8s sync: staged rke2 ${RKE2_VERSION} + airgap bundles + measured c8s Kubernetes workloads"