#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly SCRIPT_DIR
readonly PIN_MANIFEST="$SCRIPT_DIR/pin-manifest.sh"

die() {
  echo "repro-gate-changes: $*" >&2
  exit 1
}

main() {
  if [ "$#" -ne 3 ]; then
    echo "usage: repro-gate-changes CURRENT_MANIFEST BASE_MANIFEST CHANGED_PATHS_ZERO" >&2
    return 2
  fi

  local current_manifest=$1 base_manifest=$2 changed_paths=$3 path
  local image=false

  [ -f "$changed_paths" ] || die "changed-path list not found: $changed_paths"
  bash "$PIN_MANIFEST" validate --manifest "$current_manifest" >/dev/null
  jq -e '.builds["node-image"] | type == "object"' "$base_manifest" >/dev/null

  # Only the build inputs roll the measurement; a release tag beside a SHA
  # does not (pin-manifest.sh export_pins). The attestation-api digest is one:
  # the CDS image stages those bytes.
  if ! jq -e -s '
      map(.builds["node-image"] | {confos_ref, attestation_rs_ref, attestation_api_digest, mkosi_ref, mkosi_version})
      | .[0] == .[1]' \
    "$base_manifest" "$current_manifest" >/dev/null; then
    image=true
  fi
  while IFS= read -r -d '' path; do
    case "$path" in
      .github/scripts/pin-manifest.sh | \
        .github/scripts/repro-gate-changes | \
        .github/scripts/build-gate-images.sh | \
        .github/actions/setup-mkosi/action.yml | \
        .github/workflows/image-repro-gate.yml)
        image=true
        ;;
      images/node-guest/*/mkosi.extra/*)
        # Copied into the image whole; no exemption below may reach it.
        image=true
        ;;
      images/node-guest/tests/* | \
        images/node-guest/tools/* | \
        images/node-guest/*.md | \
        images/node-guest/*_test.go)
        # Tests, lint tools and docs beside the image sources; never baked.
        ;;
      images/node-guest/* | \
        .github/workflows/c8s-image.yml | \
        .github/workflows/c8s-image-publish.yml)
        image=true
        ;;
      .github/build-pins.json)
        # The manifest's domain objects were compared above.
        ;;
    esac
  done <"$changed_paths"

  printf 'image=%s\n' "$image"
}

main "$@"
