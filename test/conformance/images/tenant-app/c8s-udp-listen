#!/usr/bin/env python3
# Receives UDP on the port and prints each datagram on its own line
# (steps/mesh.go, datagramListener). Binds both families where the pod has an
# IPv6 stack (the kernel lists its addresses in /proc/net/if_inet6), IPv4
# alone otherwise.
# Usage: c8s-udp-listen <port>
import os, socket, sys
family = socket.AF_INET6 if os.path.exists("/proc/net/if_inet6") else socket.AF_INET
s = socket.socket(family, socket.SOCK_DGRAM)
s.bind(("", int(sys.argv[1])))
while True:
    print(s.recvfrom(65535)[0].decode(errors="replace"), flush=True)
