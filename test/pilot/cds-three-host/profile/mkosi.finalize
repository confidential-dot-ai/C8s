#!/bin/bash
set -euo pipefail
for unit in getty@.service serial-getty@.service console-getty.service rescue.service emergency.service ssh.service sshd.service qemu-guest-agent.service; do
    ln -sf /dev/null "$BUILDROOT/etc/systemd/system/$unit"
done
for binary in c8s attestation-api cds-three-host-agent; do
    test -x "$BUILDROOT/usr/local/bin/$binary"
done
# Public DHCP/config files must remain readable after networkd drops root.
chmod 0644 "$BUILDROOT/etc/systemd/network/80-dhcp.network"
find "$BUILDROOT/etc/systemd/system" -type f -exec chmod 0644 {} +
chmod 0644 "$BUILDROOT/etc/attestation-api/config.toml" "$BUILDROOT/usr/lib/systemd/system-preset/50-cds-three-host.preset"
