[Unit]
Description=Disposable native TDX capability probe
ConditionPathExists=/run/confai/operator-pubkey
After=network-online.target sys-kernel-config.mount
Wants=network-online.target sys-kernel-config.mount

[Service]
ExecStart=/usr/local/bin/cds-tdx-probe -mode serve
Restart=no
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ReadWritePaths=/sys/kernel/config/tsm/report
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/tdx_guest rw
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=multi-user.target
