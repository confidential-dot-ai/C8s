{
  "schema": "confidential.ai/release-allowlist-policy/v2",
  "chart": {
    "release": "confidential-inference",
    "namespace": "confidential-inference",
    "kubeVersion": "1.32.0"
  },
  "kubernetes": {
    "serviceHost": "10.53.0.1"
  },
  "workloads": [
    {
      "name": "gateway",
      "controller": "Deployment/gateway",
      "secretReads": ["/confidential-inference/gateway/api-key-pepper"]
    },
    {
      "name": "inference-worker-0",
      "controller": "StatefulSet/inference-worker-0"
    },
    {
      "name": "sglang-router",
      "controller": "Deployment/sglang-router"
    }
  ]
}
