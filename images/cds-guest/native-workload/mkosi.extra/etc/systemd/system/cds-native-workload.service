[Unit]
Description=C8s native workload qualification fixture
ConditionPathExists=/run/confai/operator-pubkey
Requires=attestation-api.service
After=attestation-api.service network-online.target
Wants=network-online.target
SuccessAction=poweroff
FailureAction=poweroff

[Service]
Type=simple
Environment=C8S_OBJECT_NATIVE_WORKLOAD=1
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt SSL_CERT_DIR=/etc/ssl/certs
ExecStart=/usr/local/bin/cds-native-workload.test -test.run=^TestObjectNativeWorkloadGuest$ -test.timeout=0
Restart=no
RuntimeMaxSec=75min
TimeoutStopSec=30
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
DevicePolicy=closed
TasksMax=256
MemoryMax=3G

[Install]
WantedBy=multi-user.target
