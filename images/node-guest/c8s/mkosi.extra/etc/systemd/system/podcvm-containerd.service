# Pod role only: containerd without RKE2, on the paths RKE2 uses, so the
# baked c8s-runc and NRI drop-ins and the containerd data disk apply unchanged.
# Not enabled: pod-status starts it once a pod is assigned and its runtime
# policy is installed, so containerd launches the admission plugin with the
# assigned pod's policy and never a generic one.
[Unit]
Description=Pod-role containerd
ConditionPathExists=/run/confos/role-pod
Requires=rke2-role.service nri-node-ip.service containerd-data-disk.service
After=rke2-role.service nri-node-ip.service containerd-data-disk.service network-online.target
Wants=network-online.target

[Service]
Type=notify
Environment=PATH=/var/lib/rancher/rke2/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# c8s-runc execs /var/lib/rancher/rke2/bin/runc; RKE2 would create this link.
ExecStartPre=/bin/ln -sfn /usr/lib/c8s/pod-runtime/bin /var/lib/rancher/rke2/bin
# Pick up node-services' veth/bridge Unmanaged drop-in before the first pod.
ExecStartPre=/usr/bin/networkctl reload
ExecStart=/var/lib/rancher/rke2/bin/containerd --config /usr/lib/c8s/pod-runtime/containerd.toml
ExecStartPost=/var/lib/rancher/rke2/bin/ctr --address /run/k3s/containerd/containerd.sock --namespace k8s.io images import /usr/lib/c8s/pod-runtime/pause.tar
# The measured mesh endpoint from the airgap archive node-services prepare
# selected, imported and pinned as RKE2 imports agent/images on a node, so
# the endpoint's IfNotPresent pull finds it and image GC keeps it.
ExecStartPost=/var/lib/rancher/rke2/bin/ctr --address /run/k3s/containerd/containerd.sock --namespace k8s.io images import --all-platforms --label io.cri-containerd.pinned=pinned /run/c8s-pod/mesh-image.tar
Delegate=yes
KillMode=process
LimitNOFILE=1048576
TimeoutStartSec=120
