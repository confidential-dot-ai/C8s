[Unit]
Description=Local workload access to the measured hardware attester
# Each image's attest-proxy.service.d/20-launch-staging.conf orders it after
# that image's launch staging.
Requires=attestation-api.service
After=attestation-api.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/c8s attest-proxy --socket=/run/nri-image-policy/attestation-api.sock --socket-gid=65532 --upstream=http://127.0.0.1:8400
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run
# Only to chgrp the socket it creates at --socket to --socket-gid, so the
# non-root workloads in that group can connect. Nothing under /dev is
# touched: the hardware attester is reached over --upstream on loopback.
CapabilityBoundingSet=CAP_CHOWN

[Install]
WantedBy=multi-user.target
