#!/usr/bin/env bash
# mkosi sync hook for the worker profile. Stages into mkosi.local/mkosi.extra:
#
#   1. kubelet, containerd, containerd-shim-runc-v2 and runc from the pinned
#      RKE2 release's rke2-runtime image -> usr/lib/c8s/worker/bin/, and
#      var/lib/rancher/rke2/bin linked to it, where c8s-runc execs runc. No
#      rke2, kubectl, ctr or crictl.
#   2. the multi-command c8s binary, also as the NRI plugin and c8s-runc:
#      either the one images/node-guest/build pre-stages at usr/local/bin/c8s,
#      or the one nri-image-policy:<c8s-ref> carries.
#   3. the router's nginx files and the worker's NRI floor, rendered from the
#      chart in that binary, this profile's floor template and its static pod
#      templates.
#
# The core image digests resolve from the registry, or from the local OCI
# layouts the build shares between the image repro gate's two runs.
#
# The RKE2 and Helm pins equal the c8s profile's (profile_test.go).
set -euo pipefail
# A FATAL inside v=$(f) ends the sync; inside an argument or a local it does not.
shopt -s inherit_errexit

STAGE_DIR="$SRCDIR/mkosi.local/mkosi.extra"
CACHE_DIR="$SRCDIR/mkosi.pkgcache/c8s"
SYNC_INPUTS="$SRCDIR/mkosi.local/.confos-sync-inputs"
mkdir -p "$STAGE_DIR" "$CACHE_DIR" "${TMPDIR:=/tmp}"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

HELM_VERSION="v3.14.4"
HELM_LINUX_AMD64_SHA256="a5844ef2c38ef6ddf3b5a8f7d91e7e0e8ebc39a38bb3fc8013d629c1ef29c259"
RKE2_VERSION="v1.36.4+rke2r1"
RKE2_IMAGES_CORE_SHA256="8988a2eff587dd88b8eab86fe719703e9541a1f08d22771a94cbec446a13db86"
RUNTIME_BINARIES=(containerd containerd-shim-runc-v2 kubelet runc)
# Where the runtime lands, the link c8s-runc execs it through, and the wrapper
# the image's containerd drop-in names. profile_test.go compares these values
# against the baked configuration and the wrapper's compiled path.
RUNTIME_BIN_DIR="/usr/lib/c8s/worker/bin"
RKE2_BIN_LINK="/var/lib/rancher/rke2/bin"
RUNC_WRAPPER="/usr/local/bin/c8s-runc"
# The CNI plugins release at RKE2's version; the worker's Cilium chains portmap.
CNI_PLUGINS_VERSION="v1.9.1"
CNI_PLUGINS_LINUX_AMD64_SHA256="b98f74a0f8522f0a83867178729c1aa70f2158f90c45a2ca8fa791db1c76b303"

input() { cat "$SYNC_INPUTS/$1" 2>/dev/null || true; }
fail() { echo "worker sync: FATAL $*" >&2; exit 1; }

PLATFORM=$(input platform)
case "$PLATFORM" in
    tdx) LABEL_PLATFORM=tdx ;;
    snp) LABEL_PLATFORM=sev-snp ;;
    *) fail "platform sync-input must be tdx or snp, got '$PLATFORM'" ;;
esac
C8S_REF=$(input c8s-ref)
[ -n "$C8S_REF" ] || fail "c8s-ref sync-input is empty"
C8S_REGISTRY=$(input c8s-registry)
C8S_REGISTRY=${C8S_REGISTRY:-ghcr.io/confidential-dot-ai}
# The build shares the OCI layouts of unpublished core images with both repro
# gate runs; every other build resolves them in the registry.
IMAGES_INPUT=$(input c8s-images)
LOCAL_IMAGES_DIR=""
ORAS_FETCH=(oras manifest fetch --descriptor)
case "$IMAGES_INPUT" in
    1)  LOCAL_IMAGES_DIR="$SRCDIR/mkosi.local/core-images"
        [ -d "$LOCAL_IMAGES_DIR" ] || fail "c8s-images=1 but no layouts at ${LOCAL_IMAGES_DIR#"$SRCDIR"/}"
        ORAS_FETCH+=(--oci-layout) ;;
    "") ;;
    *)  fail "c8s-images sync-input must be 1 or empty, got '$IMAGES_INPUT'" ;;
esac
# The build pre-stages a locally built c8s binary, or the image bakes the one
# the published plugin image carries at this ref.
C8S="$STAGE_DIR/usr/local/bin/c8s"
BINARY_INPUT=$(input c8s-binary)
case "$BINARY_INPUT" in
    1)  [ -x "$C8S" ] || fail "c8s-binary=1 but no executable binary pre-staged at usr/local/bin/c8s"
        C8S_SOURCE=prestaged ;;
    "") [ -z "$LOCAL_IMAGES_DIR" ] || fail "local core images require a pre-staged c8s binary"
        C8S_SOURCE=plugin ;;
    *)  fail "c8s-binary sync-input must be 1 or empty, got '$BINARY_INPUT'" ;;
esac
NODE_FLOOR="$SRCDIR/mkosi.profiles/worker/image-policy.yaml.in"
[ -f "$NODE_FLOOR" ] || fail "no floor template at $NODE_FLOOR"

# fetch <url> <dest> <sha256>: download once into the package cache.
fetch() {
    if [ -f "$2" ] && echo "$3  $2" | sha256sum -c --status; then
        return
    fi
    curl -fL --retry 3 --retry-delay 5 --output "$2" "$1"
    echo "$3  $2" | sha256sum -c --status || fail "sha256 mismatch for ${2##*/}"
}

# image_source <repo>: where oras reads repo's C8S_REF tag — the local OCI
# layout of repo, or repo in the registry.
image_source() {
    local layout
    case "$1" in "$C8S_REGISTRY"/*) ;; *) fail "$1 is no repository of $C8S_REGISTRY" ;; esac
    if [ -z "$LOCAL_IMAGES_DIR" ]; then
        echo "$1:$C8S_REF"
        return
    fi
    layout="$LOCAL_IMAGES_DIR/${1#"$C8S_REGISTRY"/}"
    [ -f "$layout/oci-layout" ] && [ -f "$layout/index.json" ] \
        || fail "no local OCI layout at ${layout#"$SRCDIR"/}"
    echo "$layout:$C8S_REF"
}

# digest <repo>: the digest C8S_REF names in repo.
digest() {
    local ref d
    ref=$(image_source "$1")
    d=$("${ORAS_FETCH[@]}" "$ref" | jq -r .digest)
    case "$d" in sha256:*) echo "$d" ;; *) fail "cannot resolve $ref" ;; esac
}

# amd64_manifest <repo> <digest>: the OCI image manifest for linux/amd64,
# through the index a published multi-manifest pin names.
amd64_manifest() {
    local manifest child
    manifest=$(oras manifest fetch "$1@$2")
    if [ "$(echo "$manifest" | jq -r .mediaType)" = application/vnd.oci.image.index.v1+json ]; then
        child=$(echo "$manifest" | jq -r '
            [.manifests[] | select(.platform.os == "linux" and .platform.architecture == "amd64") | .digest]
            | if length == 1 then .[0] else "" end')
        case "$child" in sha256:*) ;; *) fail "$1@$2 indexes no single linux/amd64 image" ;; esac
        manifest=$(oras manifest fetch "$1@$child")
    fi
    case "$(echo "$manifest" | jq -r .mediaType)" in
        application/vnd.oci.image.manifest.v1+json) printf '%s' "$manifest" ;;
        *) fail "$1@$2 is no OCI image" ;;
    esac
}

# layer_blob <repo> <manifest> <index>: that layer of the image, fetched once
# into TMP beside the list of its members (<blob>.list). Any layer but a gzip
# tar naming its members without ./ fails.
layer_blob() {
    local media digest blob
    media=$(echo "$2" | jq -r ".layers[$3].mediaType")
    digest=$(echo "$2" | jq -r ".layers[$3].digest")
    [ "$media" = application/vnd.oci.image.layer.v1.tar+gzip ] \
        || fail "layer $digest of $1 is $media, not a gzip tar"
    blob="$TMP/layer-${digest#sha256:}"
    if [ ! -f "$blob.list" ]; then
        oras blob fetch --output "$blob" "$1@$digest"
        tar -tzf "$blob" > "$blob.list" || fail "cannot list layer $digest of $1"
        if grep -q '^\./' "$blob.list"; then
            fail "layer $digest of $1 names its members with ./"
        fi
    fi
    echo "$blob"
}

# hides <list> <path>: whether a layer with these members hides path in the
# layers below it: a whiteout of path or of a directory above it, an opaque
# directory above it, a non-directory where a directory above it was, or path
# as a directory.
hides() {
    local dir="" rest=$2 name
    while :; do
        name=${rest%%/*}
        if grep -qFx -e "$dir.wh.$name" -e "$dir.wh..wh..opq" "$1"; then
            return 0
        fi
        if [ "$rest" = "$name" ]; then
            grep -qFx -- "$dir$name/" "$1"
            return
        fi
        if grep -qFx -- "$dir$name" "$1"; then
            return 0
        fi
        dir="$dir$name/"
        rest=${rest#*/}
    done
}

# image_file <repo> <manifest> <path>: path from the newest layer carrying it,
# extracted under TMP. A newer layer that hides path fails.
image_file() {
    local i blob dir
    i=$(echo "$2" | jq '.layers | length')
    while [ "$i" -gt 0 ]; do
        i=$((i - 1))
        blob=$(layer_blob "$1" "$2" "$i")
        if grep -qFx -- "$3" "$blob.list"; then
            dir=$(mktemp -d -p "$TMP")
            tar -xzf "$blob" -C "$dir" -- "$3" || fail "cannot extract $3 from $1"
            echo "$dir/$3"
            return
        fi
        if hides "$blob.list" "$3"; then
            fail "a layer of $1 hides $3"
        fi
    done
    fail "no $3 in $1"
}

# stage_c8s_binary <repo> <digest>: install the binary repo@digest runs as the
# NRI plugin, cached by that digest. The plugin is that binary or one symlink
# to it.
stage_c8s_binary() {
    local cache="$CACHE_DIR/nri-image-policy-${2#sha256:}"
    local manifest plugin=usr/local/bin/nri-image-policy file link target
    if [ ! -f "$cache" ]; then
        manifest=$(amd64_manifest "$1" "$2")
        file=$(image_file "$1" "$manifest" "$plugin")
        if [ -L "$file" ]; then
            link=$(readlink "$file")
            case "$link" in
                /*) target=$link ;;
                *)  target="/${plugin%/*}/$link" ;;
            esac
            # Lexically, inside the image: ".." stops at its root.
            target=$(realpath -ms -- "$target")
            file=$(image_file "$1" "$manifest" "${target#/}")
        fi
        [ -f "$file" ] && [ ! -L "$file" ] || fail "the plugin of $1@$2 is no regular file"
        install -D -m 0755 "$file" "$cache"
    fi
    install -D -m 0755 "$cache" "$C8S"
}

OPERATOR_REPO="$C8S_REGISTRY/c8s-operator"
MESH_REPO="$C8S_REGISTRY/armtls-mesh"
OPERATOR_DIGEST=$(digest "$OPERATOR_REPO")
MESH_DIGEST=$(digest "$MESH_REPO")
# Before the long fetches below, so an unpublished ref fails early.
if [ "$C8S_SOURCE" = plugin ]; then
    NRI_REPO="$C8S_REGISTRY/nri-image-policy"
    NRI_DIGEST=$(digest "$NRI_REPO")
    stage_c8s_binary "$NRI_REPO" "$NRI_DIGEST"
fi

# --- 1. Runtime binaries from the rke2-runtime image's one layer ----------
CORE="$CACHE_DIR/rke2-images-core-${RKE2_VERSION//+/-}.tar.zst"
fetch "https://github.com/rancher/rke2/releases/download/${RKE2_VERSION//+/%2B}/rke2-images-core.linux-amd64.tar.zst" \
    "$CORE" "$RKE2_IMAGES_CORE_SHA256"
zstd -dc "$CORE" | tar -x -C "$TMP" manifest.json
LAYER=$(jq -er --arg tag "rancher/rke2-runtime:${RKE2_VERSION//+/-}" \
    '[.[] | select(.RepoTags | index($tag)) | .Layers] | if length == 1 and (.[0] | length) == 1 then .[0][0] else error("want one one-layer \($tag)") end' \
    "$TMP/manifest.json")
zstd -dc "$CORE" | tar -x -C "$TMP" "$LAYER"
mkdir -p "$TMP/runtime"
tar -x -C "$TMP/runtime" -f "$TMP/$LAYER" "${RUNTIME_BINARIES[@]/#/bin/}"
for bin in "${RUNTIME_BINARIES[@]}"; do
    install -D -m 0755 "$TMP/runtime/bin/$bin" "$STAGE_DIR$RUNTIME_BIN_DIR/$bin"
done
mkdir -p "$STAGE_DIR${RKE2_BIN_LINK%/*}"
ln -sfn "$RUNTIME_BIN_DIR" "$STAGE_DIR$RKE2_BIN_LINK"

# --- 2. The plugin and the runtime wrapper --------------------------------
[ -x "$C8S" ] || fail "no executable c8s binary at usr/local/bin/c8s"
install -D -m 0755 "$C8S" "$STAGE_DIR/opt/nri/plugins/10-nri-image-policy"
install -D -m 0755 "$C8S" "$STAGE_DIR$RUNC_WRAPPER"

# --- 3. Router files and the worker floor ---------------------------------
HELM="$CACHE_DIR/helm-${HELM_VERSION}-linux-amd64.tar.gz"
fetch "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" "$HELM" "$HELM_LINUX_AMD64_SHA256"
tar -xzf "$HELM" -C "$TMP" linux-amd64/helm
RENDER="$TMP/render"
PATH="$TMP/linux-amd64:$PATH" "$C8S" node-image render \
    --hardware-platform "$LABEL_PLATFORM" \
    --kube-version "${RKE2_VERSION%%+*}" \
    --image-repository "$OPERATOR_REPO" \
    --image-digest "$OPERATOR_DIGEST" \
    --armtls-mesh-image-repository "$MESH_REPO" \
    --armtls-mesh-image-digest "$MESH_DIGEST" \
    --output-dir "$RENDER"
ROUTER_IMAGE=$(cat "$RENDER/router-image.txt")
case "$ROUTER_IMAGE" in *@sha256:*) ;; *) fail "the render's router image '$ROUTER_IMAGE' is not pinned by digest" ;; esac
sed \
    -e "s|@PLATFORM@|$PLATFORM|g" \
    -e "s|@MESH_REPO@|$MESH_REPO|g" \
    -e "s|@MESH_DIGEST@|$MESH_DIGEST|g" \
    -e "s|@OPERATOR_REPO@|$OPERATOR_REPO|g" \
    -e "s|@OPERATOR_DIGEST@|$OPERATOR_DIGEST|g" \
    -e "s|@ROUTER_REPO@|${ROUTER_IMAGE%@*}|g" \
    -e "s|@ROUTER_DIGEST@|${ROUTER_IMAGE##*@}|g" \
    "$NODE_FLOOR" > "$TMP/node-floor.yaml"
! grep -o '@[A-Z_]*@' "$TMP/node-floor.yaml" || fail "the node floor names a placeholder this sync does not fill"
TEMPLATES="$SRCDIR/mkosi.profiles/worker/mkosi.extra/usr/lib/c8s/worker/static-pods"
[ -d "$TEMPLATES" ] || fail "no static pod templates at $TEMPLATES"
"$C8S" worker floor \
    --node-floor "$TMP/node-floor.yaml" \
    --render-dir "$RENDER" \
    --static-pods "$TEMPLATES" \
    --out "$STAGE_DIR/usr/lib/c8s/image-policy.yaml"
printf '{"schema":"c8s.allowlist/v1","workloads":{}}\n' > "$STAGE_DIR/usr/lib/c8s/allowlist-seed.json"
install -D -m 0644 -t "$STAGE_DIR/usr/lib/c8s/router-nginx" "$RENDER"/router-nginx/*
# The initrd overlays only directories the image bakes (usr/lib/confai/state.d).
mkdir -p "$STAGE_DIR/etc/cni/net.d" "$STAGE_DIR/opt/cni/bin" "$STAGE_DIR/etc/nri/conf.d"
CNI_PLUGINS="$CACHE_DIR/cni-plugins-linux-amd64-${CNI_PLUGINS_VERSION}.tgz"
fetch "https://github.com/containernetworking/plugins/releases/download/${CNI_PLUGINS_VERSION}/cni-plugins-linux-amd64-${CNI_PLUGINS_VERSION}.tgz" \
    "$CNI_PLUGINS" "$CNI_PLUGINS_LINUX_AMD64_SHA256"
tar -xzf "$CNI_PLUGINS" -C "$STAGE_DIR/opt/cni/bin" ./portmap
echo "worker sync: staged the RKE2 ${RKE2_VERSION} runtime and the worker floor for c8s ${C8S_REF}"
