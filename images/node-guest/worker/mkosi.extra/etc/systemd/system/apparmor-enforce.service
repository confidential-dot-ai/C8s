[Unit]
Description=Verify AppArmor enforcement before starting the worker's runtime
After=apparmor.service
Before=containerd.service
FailureAction=poweroff-force

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /usr/local/bin/apparmor-enforce.sh
TimeoutStartSec=30
# Match the node's vsock fence; parser/aa-exec need no network sockets.
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
RequiredBy=containerd.service
