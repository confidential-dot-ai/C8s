[Unit]
Description=Disposable CDS SNP sealing qualification
ConditionPathExists=/run/confai/operator-pubkey
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/snp-probe serve -listen=0.0.0.0:8445 -launch-file=/run/confai/operator-pubkey
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/sev-guest rw
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=multi-user.target
