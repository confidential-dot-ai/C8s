# Disposable sentinel qualification only: KubeVirt exposes an ISA UART.
# Keep login services masked; do not enable the broader dev profile/debugfs.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# CONFIG_SERIAL_8250_PCI is not set
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# A host may read boot diagnostics, but serial input must not invoke SysRq.
# CONFIG_MAGIC_SYSRQ_SERIAL is not set
